      "type": "string"
    },
    "blocks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "block_id": {
            "pattern": "^BLK-[A-Z0-9-]+$",
            "type": "string"
          },
          "block_type": {
            "enum": [
              "AFFILIATE_AND_CTA_RULES",
              "AIRLINE_RULE_CARDS",
              "AI_AND_HUMAN_RESPONSIBILITY",
              "ALTERNATIVE_PATH",
              "BUY_NONE_CONDITIONS",
              "COMMON_NON_FIT",
              "COMPARISON_OR_TOOL_LINK",
              "COMPARISON_TABLE",
              "CONDITIONAL_BRANCH",
              "CONDITIONAL_NEXT_STEP",
              "CTA_GUARD",
              "DECISION_CRITERIA",
              "DECISION_INPUTS",
              "DECISION_MAP",
              "DECISION_PATHS",
              "DECISIVE_DIFFERENCES",
              "DISCLOSURE",
              "DISCLOSURE_SCOPE",
              "EDITORIAL_METHOD",
              "EXCEPTIONS_UNKNOWN",
              "FACT_TABLE",
              "FIT_NON_FIT",
              "FOOTER_POLICIES",
              "FRESHNESS_CORRECTIONS_HISTORY",
              "HERO",
              "HYPOTHETICAL_EXAMPLES",
              "INPUTS",
              "LOCAL_RESET_COPY",
              "MASTHEAD_DISCLOSURE",
              "METHOD",
              "METHOD_FRESHNESS_CORRECTION",
              "NEXT_ACTION",
              "NON_GUARANTEE",
              "NO_HANDS_ON_POLICY",
              "OFFICIAL_FACTS",
              "PRIVACY_MEASUREMENT_LINK",
              "PROBLEM_SCOPE",
              "PRODUCT_CARDS",
              "PRODUCT_COMPARISONS",
              "PUBLISHED_RELATED_LINKS",
              "PURPOSE_LIMITATION_PRIVACY",
              "QUICK_CHECK",
              "RECOMMENDATION_BUSINESS_SEPARATION",
              "RELATED_LINKS",
              "RESOLVED_RULE",
              "RESULT",
              "SCOPE",
              "SCOPE_NON_DUPLICATION",
              "SOURCES_CHANGELOG_CORRECTION",
              "SOURCES_CHECKED_DATE",
              "SOURCE_AND_CLAIM_LABELS",
              "TASK_GUIDES",
              "THIRTY_SECOND_CONCLUSION",
              "TOOL_ENTRY",
              "TRUST_STRIP",
              "UNKNOWN_EDGE_CASES",
              "VALIDATION",
              "VERIFIED_GUIDES"
            ]
          }
        },
        "required": [
          "block_id",
          "block_type"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "claim_ids": {
      "items": {
        "pattern": "^CLM-[A-Z0-9-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "disclosure": {
      "minLength": 1,
      "type": "string"
    },
    "editorial_decisions": {
      "items": {
        "pattern": "^ED-[A-Z0-9-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "parent_hub": {
      "pattern": "^/(?:[a-z0-9-]+/)*$",
      "type": [
        "string",
        "null"
      ]
    },
    "primary_intent_id": {
      "pattern": "^INT-[A-Z0-9-]+$",
      "type": "string"
    },
    "review_state": {
      "enum": [
        "DRAFT",
        "EVIDENCE_COMPLETE",
        "REVIEW_REQUIRED",
        "HUMAN_REVIEWED"
      ]
    },
    "route": {
      "pattern": "^/(?:[a-z0-9-]+/)*$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_checked_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "template": {
      "enum": [
        "HOME",
        "HUB",
        "GUIDE",
        "COMPARISON",
        "DIFFERENCE",
        "TOOL",
        "POLICY"
      ]
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "route",
    "template",
    "primary_intent_id",
    "parent_hub",
    "claim_ids",
    "editorial_decisions",
    "blocks",
    "disclosure",
    "source_checked_at",
    "review_state"
  ],
  "title": "article-definition",
  "type": "object"
}
