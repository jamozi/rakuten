{
  "$id": "https://kurashinoshirube.com/contracts/raos-v2/v1/claim.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "A_OFFICIAL_FACT"
          }
        }
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1
          },
          "value": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "D_EDITORIAL_JUDGEMENT"
          }
        }
      },
      "then": {
        "properties": {
          "logic_inputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "DRAFT",
              "BLOCKED"
            ]
          },
          "unit": {
            "type": "null"
          },
          "value": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "checked_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "claim_id": {
      "pattern": "^CLM-[A-Z0-9-]+$",
      "type": "string"
    },
    "claim_type": {
      "enum": [
        "A_OFFICIAL_FACT",
        "D_EDITORIAL_JUDGEMENT",
        "UNKNOWN"
      ]
    },
    "logic_inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "input_id": {
            "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
            "type": "string"
          },
          "value_ref": {
            "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "input_id",
          "value_ref"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "type": "array"
    },
    "next_review_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "predicate": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "risk_class": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_ids": {
      "items": {
        "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "DRAFT",
        "VERIFIED",
        "STALE",
        "BLOCKED"
      ]
    },
    "subject_id": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$",
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "object",
        "array",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "claim_type",
    "subject_id",
    "predicate",
    "value",
    "unit",
    "source_ids",
    "logic_inputs",
    "checked_at",
    "next_review_at",
    "risk_class",
    "status"
  ],
  "title": "claim",
  "type": "object"
}
