{
  "$id": "https://kurashinoshirube.com/contracts/raos-v2/v1/product-model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "identity_status": {
            "const": "EXACT"
          }
        }
      },
      "then": {
        "properties": {
          "model_number": {
            "minLength": 1,
            "type": "string"
          },
          "official_source_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "brand": {
      "minLength": 1,
      "type": "string"
    },
    "generation": {
      "minLength": 1,
      "type": "string"
    },
    "identity_status": {
      "enum": [
        "EXACT",
        "AMBIGUOUS",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "manufacturer": {
      "minLength": 1,
      "type": "string"
    },
    "model_name": {
      "minLength": 1,
      "type": "string"
    },
    "model_number": {
      "minLength": 1,
      "type": "string"
    },
    "official_source_ids": {
      "items": {
        "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "product_id": {
      "pattern": "^PRD-[A-Z0-9-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "variants": {
      "items": {
        "$ref": "product-variant.schema.json"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "product_id",
    "manufacturer",
    "brand",
    "model_name",
    "model_number",
    "generation",
    "variants",
    "official_source_ids",
    "identity_status"
  ],
  "title": "product-model",
  "type": "object"
}
