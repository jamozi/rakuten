{
  "$id": "https://kurashinoshirube.com/contracts/raos-v2/v2/preaction-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "current_public_body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "legacy_post_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provenance": {
      "const": "PUBLIC_READ_ONLY_CAPTURE_AND_OWNER_WORDPRESS_EXPORT"
    },
    "public_capture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "RAOS_V2_PHASE3_PREACTION_BINDING_V1"
    },
    "status": {
      "const": "VERIFIED_PREACTION"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "exact_match_count": {
          "const": 1
        },
        "kind": {
          "const": "EXISTING_POST"
        },
        "origin": {
          "const": "https://kurashinoshirube.com"
        },
        "post_id": {
          "minimum": 1,
          "type": "integer"
        },
        "route": {
          "const": "/carry-on-suitcase-comparison/"
        }
      },
      "required": [
        "origin",
        "route",
        "kind",
        "post_id",
        "exact_match_count"
      ],
      "type": "object"
    },
    "version": {
      "const": "1.0.0"
    },
    "wordpress_export_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "wordpress_export_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "status",
    "provenance",
    "captured_at",
    "target",
    "current_public_body_sha256",
    "public_capture_sha256",
    "wordpress_export_sha256",
    "wordpress_export_bytes",
    "owner_evidence_sha256",
    "legacy_post_content_sha256"
  ],
  "title": "preaction-binding",
  "type": "object"
}
