{
  "$id": "https://kurashinoshirube.com/contracts/raos-v2/v2/reissued-review-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": false
        },
        "publish": {
          "const": false
        },
        "wordpress_read": {
          "const": false
        },
        "wordpress_write": {
          "const": false
        }
      },
      "required": [
        "network",
        "wordpress_read",
        "wordpress_write",
        "publish"
      ],
      "type": "object"
    },
    "classification": {
      "const": "LOCAL_REISSUE_FOR_ARTIFACT_SPECIFIC_HUMAN_REVIEW"
    },
    "external_actions": {
      "const": "NOT_EXECUTED"
    },
    "maximum_reissue_age_seconds": {
      "const": 300
    },
    "owner_export_age_milliseconds": {
      "maximum": 300000,
      "minimum": 0,
      "type": "integer"
    },
    "payload_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "public_capture_age_milliseconds": {
      "maximum": 300000,
      "minimum": 0,
      "type": "integer"
    },
    "reissue_age_milliseconds": {
      "maximum": 300000,
      "minimum": 0,
      "type": "integer"
    },
    "reissued_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "review_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "review_candidate": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "preaction_status": {
                "const": "HISTORICAL_BASELINE_ONLY"
              }
            }
          },
          "then": {
            "properties": {
              "preaction_binding_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preaction_status": {
                "const": "VERIFIED_PREACTION"
              }
            }
          },
          "then": {
            "properties": {
              "preaction_binding_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "claim_bindings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "authoritative_source_status": {
                "enum": [
                  "DRAFT",
                  "VERIFIED",
                  "STALE",
                  "BLOCKED"
                ]
              },
              "blocking": {
                "type": "boolean"
              },
              "checked_at": {
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
                "type": "string"
              },
              "claim_id": {
                "pattern": "^CLM-[A-Z0-9-]+$",
                "type": "string"
              },
              "claim_type": {
                "enum": [
                  "A_OFFICIAL_FACT",
                  "D_EDITORIAL_JUDGEMENT",
                  "UNKNOWN"
                ]
              },
              "freshness": {
                "enum": [
                  "FRESH",
                  "DUE",
                  "SOFT_STALE",
                  "HARD_STALE",
                  "UNKNOWN",
                  "UNAVAILABLE",
                  "REJECTED"
                ]
              },
              "intentionally_disclosed": {
                "type": "boolean"
              },
              "next_review_at": {
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
                "type": "string"
              },
              "resolved": {
                "type": "boolean"
              },
              "risk_class": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              }
            },
            "required": [
              "claim_id",
              "claim_type",
              "risk_class",
              "freshness",
              "authoritative_source_status",
              "checked_at",
              "next_review_at",
              "resolved",
              "blocking",
              "intentionally_disclosed"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "payload_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "phase2_candidate": {
          "$ref": "https://kurashinoshirube.com/contracts/raos-v2/v1/publication-package.schema.json"
        },
        "preaction_binding_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "preaction_status": {
          "enum": [
            "HISTORICAL_BASELINE_ONLY",
            "VERIFIED_PREACTION"
          ]
        },
        "schema": {
          "const": "RAOS_V2_PHASE3_REVIEW_CANDIDATE_V1"
        },
        "structured_data_expectation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "update_payload": {
          "$ref": "https://kurashinoshirube.com/contracts/raos-v2/v2/wordpress-update-payload.schema.json"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "schema",
        "version",
        "phase2_candidate",
        "candidate_digest",
        "claim_bindings",
        "update_payload",
        "preaction_status",
        "preaction_binding_digest",
        "structured_data_expectation_sha256",
        "payload_digest"
      ],
      "type": "object"
    },
    "review_request": {
      "additionalProperties": false,
      "properties": {
        "artifact_specific_review_required": {
          "const": true
        },
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "generic_approval_accepted": {
          "const": false
        },
        "payload_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "required_receipt_schema": {
          "const": "RAOS_V2_PHASE3_HUMAN_REVIEW_RECEIPT_V1"
        },
        "target_route": {
          "const": "/carry-on-suitcase-comparison/"
        }
      },
      "required": [
        "required_receipt_schema",
        "candidate_digest",
        "payload_digest",
        "target_route",
        "generic_approval_accepted",
        "artifact_specific_review_required"
      ],
      "type": "object"
    },
    "schema": {
      "const": "RAOS_V2_PHASE3_REISSUED_REVIEW_BUNDLE_V1"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "historical_review_candidate": {
          "const": "changes/raos-v2/phase-3/generated/review-candidate.v1.json"
        },
        "historical_review_candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "preaction_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "preaction_input": {
          "pattern": "^changes/raos-v2/recorded-inputs/phase3/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
          "type": "string"
        },
        "preaction_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "historical_review_candidate",
        "historical_review_candidate_sha256",
        "preaction_input",
        "preaction_input_sha256",
        "preaction_binding_sha256"
      ],
      "type": "object"
    },
    "state": {
      "const": "READY_FOR_ARTIFACT_SPECIFIC_HUMAN_REVIEW"
    },
    "version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema",
    "version",
    "classification",
    "state",
    "reissued_at",
    "reissue_age_milliseconds",
    "public_capture_age_milliseconds",
    "owner_export_age_milliseconds",
    "maximum_reissue_age_seconds",
    "source",
    "review_candidate",
    "candidate_digest",
    "payload_digest",
    "review_request",
    "capabilities",
    "external_actions",
    "review_bundle_sha256"
  ],
  "title": "reissued-review-bundle",
  "type": "object"
}
