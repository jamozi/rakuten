{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content/v1/recommendation-methodology.schema.json",
  "title": "Recommendation Methodology Version",
  "type": "object",
  "properties": {
    "methodology_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "article_type": {
      "type": "string",
      "enum": [
        "selection_guide",
        "use_case_recommendation",
        "product_comparison",
        "model_generation_capacity_difference",
        "condition_filtering"
      ]
    },
    "decision_context": {
      "type": "object",
      "properties": {
        "target_reader": {
          "type": "string",
          "minLength": 1
        },
        "use_case": {
          "type": "string",
          "minLength": 1
        },
        "budget_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 30
        },
        "soft_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 30
        }
      },
      "required": [
        "target_reader",
        "use_case",
        "budget_context",
        "hard_constraints",
        "soft_preferences"
      ],
      "additionalProperties": false
    },
    "candidate_universe_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "comparison_axis_ref": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "normalization_rule_ref": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "critical": {
            "type": "boolean"
          }
        },
        "required": [
          "comparison_axis_ref",
          "weight",
          "normalization_rule_ref",
          "critical"
        ],
        "additionalProperties": false
      }
    },
    "excluded_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "affiliate_rate",
          "commission",
          "epc",
          "rpm",
          "revenue",
          "contribution_profit",
          "sponsor_benefit"
        ]
      },
      "minItems": 7,
      "uniqueItems": true
    },
    "approved_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "methodology_id",
    "version",
    "article_type",
    "decision_context",
    "candidate_universe_ref",
    "dimensions",
    "excluded_inputs",
    "approved_by",
    "approved_at"
  ],
  "additionalProperties": false
}
