{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content/v1/content-ast.schema.json",
  "title": "RAOS Content AST v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "article_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "article_version_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "article_type": {
      "type": "string",
      "enum": [
        "selection_guide",
        "use_case_recommendation",
        "product_comparison",
        "model_generation_capacity_difference",
        "condition_filtering"
      ]
    },
    "locale": {
      "const": "ja-JP"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "methodology_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "seo_metadata_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "source_packet_version_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "blocks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 250,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/block_lead"
          },
          {
            "$ref": "#/$defs/block_decision_summary"
          },
          {
            "$ref": "#/$defs/block_intended_reader"
          },
          {
            "$ref": "#/$defs/block_methodology"
          },
          {
            "$ref": "#/$defs/block_selection_criteria"
          },
          {
            "$ref": "#/$defs/block_heading"
          },
          {
            "$ref": "#/$defs/block_paragraph"
          },
          {
            "$ref": "#/$defs/block_bullet_list"
          },
          {
            "$ref": "#/$defs/block_numbered_list"
          },
          {
            "$ref": "#/$defs/block_comparison_table"
          },
          {
            "$ref": "#/$defs/block_product_card"
          },
          {
            "$ref": "#/$defs/block_recommendation_group"
          },
          {
            "$ref": "#/$defs/block_difference_matrix"
          },
          {
            "$ref": "#/$defs/block_pros_cons"
          },
          {
            "$ref": "#/$defs/block_tradeoff"
          },
          {
            "$ref": "#/$defs/block_caution"
          },
          {
            "$ref": "#/$defs/block_evidence_note"
          },
          {
            "$ref": "#/$defs/block_source_summary"
          },
          {
            "$ref": "#/$defs/block_faq"
          },
          {
            "$ref": "#/$defs/block_media"
          },
          {
            "$ref": "#/$defs/block_internal_links"
          },
          {
            "$ref": "#/$defs/block_update_notice"
          },
          {
            "$ref": "#/$defs/block_callout"
          },
          {
            "$ref": "#/$defs/block_disclosure_slot"
          }
        ]
      }
    },
    "publication_flags": {
      "type": "object",
      "properties": {
        "affiliate_content": {
          "type": "boolean",
          "const": true
        },
        "human_approval_required": {
          "type": "boolean",
          "const": true
        },
        "allow_auto_publish": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "affiliate_content",
        "human_approval_required",
        "allow_auto_publish"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "article_version_id",
    "article_type",
    "locale",
    "title",
    "methodology_ref",
    "seo_metadata_ref",
    "source_packet_version_ref",
    "blocks",
    "publication_flags"
  ],
  "additionalProperties": false,
  "$defs": {
    "rich_text_node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "strong"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "emphasis"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "inline_code"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "internal_link"
            },
            "route_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "route_ref",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "approved_external_citation"
            },
            "source_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "source_ref",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "line_break"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rich_text": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rich_text_node"
      },
      "minItems": 1,
      "maxItems": 400
    },
    "block_lead": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "lead"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "content": {
          "$ref": "#/$defs/rich_text"
        }
      },
      "required": [
        "block_id",
        "type",
        "claim_ids",
        "content"
      ],
      "additionalProperties": false
    },
    "block_decision_summary": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "decision_summary"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "recommendation_ref": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
              },
              "summary": {
                "$ref": "#/$defs/rich_text"
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
                },
                "uniqueItems": true,
                "maxItems": 100,
                "default": []
              }
            },
            "required": [
              "condition",
              "summary",
              "claim_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "block_id",
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "block_intended_reader": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "intended_reader"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "fits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/rich_text"
          }
        },
        "not_fits": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/rich_text"
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/rich_text"
          }
        }
      },
      "required": [
        "block_id",
        "type",
        "claim_ids",
        "fits",
        "not_fits",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "block_methodology": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "methodology"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "methodology_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "candidate_universe_summary": {
          "$ref": "#/$defs/rich_text"
        },
        "inclusion_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rich_text"
          },
          "minItems": 1,
          "maxItems": 30
        },
        "exclusion_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rich_text"
          },
          "maxItems": 30
        },
        "data_checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "block_id",
        "type",
        "claim_ids",
        "methodology_ref",
        "candidate_universe_summary",
        "inclusion_rules",
        "exclusion_rules",
        "data_checked_at"
      ],
      "additionalProperties": false
    },
    "block_selection_criteria": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "selection_criteria"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "comparison_axis_ref": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "explanation": {
                "$ref": "#/$defs/rich_text"
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
                },
                "uniqueItems": true,
                "maxItems": 100,
                "default": []
              }
            },
            "required": [
              "comparison_axis_ref",
              "label",
              "explanation",
              "claim_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "block_id",
        "type",
        "criteria"
      ],
      "additionalProperties": false
    },
    "block_heading": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "heading"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "level": {
          "type": "integer",
          "enum": [
            2,
            3
          ]
        },
        "content": {
          "$ref": "#/$defs/rich_text"
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
        }
      },
      "required": [
        "block_id",
        "type",
        "claim_ids",
        "level",
        "content",
        "anchor_id"
      ],
      "additionalProperties": false
    },
    "block_paragraph": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "paragraph"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "content": {
          "$ref": "#/$defs/rich_text"
        }
      },
      "required": [
        "block_id",
        "type",
        "claim_ids",
        "content"
      ],
      "additionalProperties": false
    },
    "block_bullet_list": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "bullet_list"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "$ref": "#/$defs/rich_text"
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
                },
                "uniqueItems": true,
                "maxItems": 100,
                "default": []
              }
            },
            "required": [
              "content",
              "claim_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "block_id",
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "block_numbered_list": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "numbered_list"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "$ref": "#/$defs/rich_text"
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
                },
                "uniqueItems": true,
                "maxItems": 100,
                "default": []
              }
            },
            "required": [
              "content",
              "claim_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "block_id",
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "block_comparison_table": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "comparison_table"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "admin_only"
          ],
          "default": "public"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "comparison_table_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "comparison_axis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "product_selection_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true
        },
        "display_mode": {
          "type": "string",
          "enum": [
            "desktop_table_mobile_cards",
            "cards_only",
            "matrix"
          ]
        },
        "show_unknown_values": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "block_id",
        "type",
        "claim_ids",
        "comparison_table_ref",
        "comparison_axis_refs",
        "product_selection_refs",
        "display_mode",
        "show_unknown_values"
      ],
      "additionalProperties": false
    },
    "block_product_card": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
        },
        "type": {
          "const": "product_card"
        },
        "visibility": {
          "type": "string",
          "enum": [
