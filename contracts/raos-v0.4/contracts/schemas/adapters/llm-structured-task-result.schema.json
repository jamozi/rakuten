{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/adapters/llm-structured-task-result.schema.json",
  "title": "LLM Structured Task Result",
  "description": "Provider-neutral response after provider call; output still requires schema/reference/policy validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "model_id",
    "request_sha256",
    "response_sha256",
    "received_at",
    "output",
    "usage",
    "estimated_cost_jpy",
    "raw_artifact"
  ],
  "properties": {
    "provider": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "model_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "refusal": {
      "type": [
        "string",
        "null"
      ]
    },
    "output": {
      "type": "object"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "estimated_cost_jpy": {
      "type": "integer",
      "minimum": 0
    },
    "provider_cost_native": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_artifact": {
      "$ref": "../common/artifact-ref.schema.json"
    },
    "provider_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rate_limit_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  }
}
