{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/adapters/ga4-run-report-request.schema.json",
  "title": "GA4 Data API runReport Request",
  "description": "GA4 Data API v1 runReport Adapter input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "date_ranges",
    "dimensions",
    "metrics",
    "limit",
    "offset"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "date_ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_date",
          "end_date"
        ],
        "properties": {
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dimension_filter": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "metric_filter": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "order_bys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250000,
      "default": 10000
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "keep_empty_rows": {
      "type": "boolean",
      "default": false
    },
    "return_property_quota": {
      "type": "boolean",
      "default": true
    }
  }
}
