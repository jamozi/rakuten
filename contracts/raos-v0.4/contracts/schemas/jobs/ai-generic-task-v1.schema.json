{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/jobs/ai-generic-task-v1.schema.json",
  "title": "ai.generic_task.v1",
  "description": "登録済みTask Definitionを明示実行する汎用入口。allowlist taskのみ。",
  "allOf": [
    {
      "$ref": "../common/job-message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "job_type": {
          "const": "ai.generic_task.v1"
        },
        "queue": {
          "const": "ai"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_code": {
              "type": "string"
            },
            "source_packet_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "article_plan_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "article_version_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "prompt_version_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "model_route_version_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "input": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "task_code",
            "source_packet_version_id",
            "input"
          ]
        }
      }
    }
  ]
}
