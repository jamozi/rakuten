{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/events/jp-raos-publishing-article-published-v1.schema.json",
  "title": "jp.raos.publishing.article_published.v1",
  "description": "Snapshotが公開Projectionへ反映された。",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "jp.raos.publishing.article_published.v1"
        },
        "producer": {
          "const": "publishing"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publication_id": {
              "type": "string",
              "format": "uuid"
            },
            "publication_snapshot_id": {
              "type": "string",
              "format": "uuid"
            },
            "article_id": {
              "type": "string",
              "format": "uuid"
            },
            "canonical_path": {
              "type": "string"
            },
            "projection_generation": {
              "type": "integer"
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "publication_id",
            "publication_snapshot_id",
            "article_id",
            "canonical_path",
            "projection_generation",
            "published_at"
          ]
        }
      }
    }
  ]
}
