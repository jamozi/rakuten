              "format": "uuid"
            },
            "task_definition_id": {
              "type": "string",
              "format": "uuid"
            },
            "prompt_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "model_route_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "resolved_model_id": {
              "type": "string",
              "format": "uuid"
            },
            "output_schema_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "policy_bundle_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "code_git_sha": {
              "type": "string",
              "minLength": 40,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{40,64}$"
