{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/events/jp-raos-evidence-source-packet-approved-v1.schema.json",
  "title": "jp.raos.evidence.source_packet_approved.v1",
  "description": "Source Packet Versionが人間承認された。",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "jp.raos.evidence.source_packet_approved.v1"
        },
        "producer": {
          "const": "evidence"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_packet_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_packet_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "article_plan_id": {
              "type": "string",
              "format": "uuid"
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "source_packet_id",
            "source_packet_version_id",
            "article_plan_id",
            "approved_at"
          ]
        }
      }
    }
  ]
}
