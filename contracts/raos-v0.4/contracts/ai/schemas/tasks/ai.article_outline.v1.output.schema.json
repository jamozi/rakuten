{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/ai/article_outline/v1",
  "title": "Article Outline Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title_options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "primary_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,79}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "required_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "required_fact_types": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "uniqueItems": true
          },
          "position": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "section_key",
          "heading",
          "objective",
          "required_fact_ids",
          "required_fact_types",
          "position"
        ]
      }
    },
    "faq_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 30
    },
    "disclosure_required": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "title_options",
    "primary_intent",
    "sections",
    "faq_questions",
    "disclosure_required"
  ]
}
