{
  "content_markup": {
    "affiliate_cta": {
      "class": "raos-cta",
      "data_attributes": [
        "data-raos-article-id",
        "data-raos-placement",
        "data-raos-product-id"
      ],
      "exact_label": "楽天市場で現在の価格・在庫・カラーを見る",
      "rel_tokens": ["nofollow", "sponsored"],
      "required_host_provenance": "VALIDATED_RAKUTEN_DIRECT_AFFILIATE_URL"
    },
    "comparison": {
      "class": "raos-comparison",
      "desktop_view_class": "raos-comparison__table-view",
      "mobile_breakpoint_max_px": 640,
      "mobile_card_class": "raos-comparison-card",
      "mobile_semantics": "article>dl>div>dt+dd",
      "mobile_view_class": "raos-comparison__cards",
      "difference_marker": "data-raos-difference=true plus visible value/evidence label",
      "event_attributes": ["data-raos-article-id", "data-raos-placement=comparison_table"],
      "required_attributes": ["aria-labelledby", "role=region", "tabindex=0"],
      "semantic_element": "table"
    },
    "condition_label_class": "raos-condition-label",
    "product_card": {
      "body_class": "raos-product-card__body",
      "card_class": "raos-product-card",
      "grid_class": "raos-product-grid",
      "image": {
        "css_max_height_px": 128,
        "css_max_width_px": 128,
        "declared_height_px": 128,
        "declared_width_px": 128,
        "media_class": "raos-product-card__media",
        "transformation": "NONE",
        "upscale": false
      },
      "event_attribute": "data-raos-product-id",
      "presentation_v2_fields": [
        "benefit",
        "recommendation_reason",
        "fits",
        "not_fits",
        "facts_checked_on",
        "official_source_ref",
        "detail_anchor",
        "cta_context"
      ],
      "source_link_class": "raos-source-link"
    },
    "evidence_labels": {
      "A": "公式仕様",
      "B": "第三者実測",
      "C": "利用者の傾向",
      "D": "編集部の判断",
      "UNKNOWN": "未確認"
    }
  },
