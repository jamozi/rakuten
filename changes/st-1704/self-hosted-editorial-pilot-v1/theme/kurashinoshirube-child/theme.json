{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        {"slug": "paper", "name": "Paper", "color": "#f7f2e9"},
        {"slug": "ink", "name": "Ink", "color": "#17243f"},
        {"slug": "indigo", "name": "Deep Indigo", "color": "#24365f"},
        {"slug": "warm", "name": "Warm Clay", "color": "#983f25"},
        {"slug": "mist", "name": "Mist", "color": "#d6dfdc"},
        {"slug": "white", "name": "White", "color": "#ffffff"}
      ]
    },
    "layout": {"contentSize": "45rem", "wideSize": "76rem"},
    "spacing": {"blockGap": true, "units": ["rem", "vw", "%"]},
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "editorial-serif",
          "name": "Editorial Serif",
          "fontFamily": "'Hiragino Mincho ProN', 'Yu Mincho', YuMincho, 'Noto Serif CJK JP', 'Noto Serif JP', serif"
        },
        {
          "slug": "editorial-sans",
          "name": "Editorial Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN', 'Yu Gothic', YuGothic, 'Noto Sans CJK JP', 'Noto Sans JP', sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {"background": "#f7f2e9", "text": "#17243f"},
    "spacing": {"blockGap": "1.5rem"},
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--editorial-sans)",
      "fontSize": "clamp(1rem, 0.96rem + 0.2vw, 1.1rem)",
      "lineHeight": "1.85"
    },
    "elements": {
      "button": {
        "color": {"background": "#24365f", "text": "#ffffff"},
        "border": {"radius": "0.35rem"},
        "typography": {"fontWeight": "700"}
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--editorial-serif)",
          "fontWeight": "600",
          "lineHeight": "1.35"
        }
      },
      "link": {"color": {"text": "#24365f"}}
    }
  }
}
