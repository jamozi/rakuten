{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content/v1/blocks/decision_summary.schema.json",
  "title": "Decision summary block",
  "type": "object",
  "properties": {
    "block_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "type": {
      "const": "decision_summary"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "admin_only"
      ],
      "default": "public"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "recommendation_ref": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
          },
          "summary": {
            "$ref": "#/$defs/rich_text"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "uniqueItems": true,
            "maxItems": 100,
            "default": []
          }
        },
        "required": [
          "condition",
          "summary",
          "claim_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "block_id",
    "type",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "rich_text_node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "strong"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "emphasis"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "inline_code"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "internal_link"
            },
            "route_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "route_ref",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "approved_external_citation"
            },
            "source_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "source_ref",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "line_break"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rich_text": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rich_text_node"
      },
      "minItems": 1,
      "maxItems": 400
    }
  }
}
