node-storage-check:
	$(NODE_RUN) "$(NODE_INVENTORY)" guard \
		"$(RAOS_REPOSITORY_ROOT)/apps" \
		"$(RAOS_REPOSITORY_ROOT)/apps/web" \
		"$(RAOS_REPOSITORY_ROOT)/packages" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-contracts" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-ui" \
		"$(NPM_CACHE)" "$(NODE_MODULES)" \
		"$(RAOS_REPOSITORY_ROOT)/apps/web/node_modules" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-contracts/node_modules" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-ui/node_modules"
	$(NODE_RUN) "$(NODE_INVENTORY)" guard-files \
		"$(NPM_CONFIG)" "$(RAOS_REPOSITORY_ROOT)/package.json" \
		"$(RAOS_REPOSITORY_ROOT)/apps/web/package.json" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-contracts/package.json" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-contracts/tsconfig.json" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-ui/package.json"
	$(NODE_RUN) "$(NODE_INVENTORY)" guard-optional-files \
		"$(RAOS_REPOSITORY_ROOT)/package-lock.json"

node-lock: node-storage-check
	$(NPM_RUN) install --package-lock-only

node-lock-check: node-storage-check
	test -f "$(RAOS_REPOSITORY_ROOT)/package-lock.json"
	$(NODE_RUN) "$(NODE_INVENTORY)" verify-lock-manifests \
		"$(RAOS_REPOSITORY_ROOT)/package-lock.json" \
		"$(RAOS_REPOSITORY_ROOT)/package.json" \
		"$(RAOS_REPOSITORY_ROOT)/apps/web/package.json" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-contracts/package.json" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-ui/package.json"
	@set -eu; \
		before=$$(sha256sum "$(RAOS_REPOSITORY_ROOT)/package-lock.json"); \
		if test "$(RAOS_CI_OFFLINE)" = 1; then offline=--offline; \
		else offline=; fi; \
		$(NPM_RUN) ci --dry-run $$offline >/dev/null; \
		after=$$(sha256sum "$(RAOS_REPOSITORY_ROOT)/package-lock.json"); \
		test "$$before" = "$$after"

node-sync: node-lock-check
	@if test "$(RAOS_CI_OFFLINE)" = 1; then \
		test "$(RAOS_NETWORK_DENIED)" = 1; \
		test -d "$(NODE_MODULES)"; \
		test ! -L "$(NODE_MODULES)"; \
	else \
		$(NPM_RUN) ci; \
	fi
	$(NODE_RUN) "$(NODE_INVENTORY)" guard \
		"$(NPM_CACHE)" "$(NODE_MODULES)" \
		"$(RAOS_REPOSITORY_ROOT)/apps/web/node_modules" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-contracts/node_modules" \
		"$(RAOS_REPOSITORY_ROOT)/packages/web-ui/node_modules"

node-sync-offline: node-storage-check
	test -f "$(RAOS_REPOSITORY_ROOT)/package-lock.json"
	test -d "$(NPM_CACHE)"
	test -d "$(NODE_MODULES)"
	@set -eu; \
		before=$$(sha256sum "$(RAOS_REPOSITORY_ROOT)/package-lock.json"); \
		$(NPM_RUN) ci --dry-run --offline >/dev/null; \
		after=$$(sha256sum "$(RAOS_REPOSITORY_ROOT)/package-lock.json"); \
		test "$$before" = "$$after"
	@set -eu; \
		temporary=$$(mktemp -d "$(RAOS_REPOSITORY_ROOT)/.node-offline-check.XXXXXX"); \
		trap 'rm -rf -- "$$temporary"' EXIT HUP INT TERM; \
		mkdir -p -- "$$temporary/apps/web" \
			"$$temporary/packages/web-contracts" \
			"$$temporary/packages/web-ui"; \
		cp -- "$(RAOS_REPOSITORY_ROOT)/package.json" \
			"$(RAOS_REPOSITORY_ROOT)/package-lock.json" \
			"$(RAOS_REPOSITORY_ROOT)/.npmrc" "$$temporary/"; \
		cp -- "$(RAOS_REPOSITORY_ROOT)/apps/web/package.json" \
			"$$temporary/apps/web/package.json"; \
		cp -- "$(RAOS_REPOSITORY_ROOT)/packages/web-contracts/package.json" \
			"$$temporary/packages/web-contracts/package.json"; \
		cp -- "$(RAOS_REPOSITORY_ROOT)/packages/web-ui/package.json" \
			"$$temporary/packages/web-ui/package.json"; \
		$(NPM_RUN) --prefix "$$temporary" ci --offline; \
		$(NODE_RUN) "$(NODE_INVENTORY)" guard \
			"$$temporary/node_modules"; \
		$(NODE_RUN) "$(NODE_INVENTORY)" inventory \
			"$(NODE_MODULES)" >"$$temporary/installed.inventory"; \
		$(NODE_RUN) "$(NODE_INVENTORY)" inventory \
			"$$temporary/node_modules" >"$$temporary/offline.inventory"; \
		cmp -- "$$temporary/installed.inventory" "$$temporary/offline.inventory"

node-tool-versions: | node-sync
	$(NODE_RUN) --version | grep -Fx 'v$(NODE_VERSION)'
	$(NPM_RUN) --version | grep -Fx '$(NPM_VERSION)'
