override RAOS_REPOSITORY_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
override RAOS_MAKE_SHORT_FLAGS := $(firstword $(MAKEFLAGS))
ifneq ($(filter -%,$(RAOS_MAKE_SHORT_FLAGS)),)
override RAOS_MAKE_SHORT_FLAGS :=
endif
override RAOS_UNSAFE_MAKE_MODES := $(strip $(foreach flag,e i n t,$(if $(findstring $(flag),$(RAOS_MAKE_SHORT_FLAGS)),$(flag))))
RAOS_CI_OFFLINE ?= 0

ifeq ($(origin MAKEFLAGS),command line)
$(error Direct MAKEFLAGS assignments are not allowed for repository gates)
endif
ifneq ($(strip $(MAKEFILES)),)
$(error Preloaded MAKEFILES are not allowed for repository gates)
endif
ifneq ($(RAOS_UNSAFE_MAKE_MODES),)
$(error Refusing non-verifying GNU Make mode(s): $(RAOS_UNSAFE_MAKE_MODES))
endif
ifneq ($(RAOS_CI_OFFLINE),0)
ifneq ($(RAOS_CI_OFFLINE),1)
$(error RAOS_CI_OFFLINE must be 0 or 1)
endif
endif

