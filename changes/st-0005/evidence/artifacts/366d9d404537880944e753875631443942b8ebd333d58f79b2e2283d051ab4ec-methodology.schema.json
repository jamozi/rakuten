{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content/v1/blocks/methodology.schema.json",
  "title": "Methodology block",
  "type": "object",
  "properties": {
    "block_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "type": {
      "const": "methodology"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "admin_only"
      ],
      "default": "public"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
      },
      "uniqueItems": true,
      "maxItems": 100,
      "default": []
    },
    "methodology_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "candidate_universe_summary": {
      "$ref": "#/$defs/rich_text"
    },
    "inclusion_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rich_text"
      },
      "minItems": 1,
      "maxItems": 30
    },
    "exclusion_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rich_text"
      },
      "maxItems": 30
    },
    "data_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "block_id",
    "type",
    "claim_ids",
    "methodology_ref",
    "candidate_universe_summary",
    "inclusion_rules",
    "exclusion_rules",
    "data_checked_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "rich_text_node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "strong"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "emphasis"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "inline_code"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "internal_link"
            },
            "route_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "route_ref",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "approved_external_citation"
            },
            "source_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
            },
            "children": {
              "$ref": "#/$defs/rich_text"
            }
          },
          "required": [
            "type",
            "source_ref",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "line_break"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rich_text": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rich_text_node"
      },
      "minItems": 1,
      "maxItems": 400
    }
  }
}
