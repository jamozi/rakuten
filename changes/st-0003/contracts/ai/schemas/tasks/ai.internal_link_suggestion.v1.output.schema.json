{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/ai/internal_link_suggestion/v1",
  "title": "Internal Link Suggestion Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "links": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_article_id": {
            "type": "string",
            "format": "uuid"
          },
          "anchor_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "placement_block_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reader_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "target_article_id",
          "anchor_text",
          "placement_block_key",
          "reader_value",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "links"
  ]
}
