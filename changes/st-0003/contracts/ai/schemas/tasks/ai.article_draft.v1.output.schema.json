{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/ai/article_draft/v1",
  "title": "Article Draft Structured Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "meta_title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 70
        },
        "meta_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 180
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "block_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{1,79}$"
              },
              "block_type": {
                "type": "string",
                "enum": [
                  "heading",
                  "paragraph",
                  "summary",
                  "selection_criteria",
                  "comparison_table",
                  "product_card",
                  "pros_cons",
                  "suitable_unsuitable",
                  "warning",
                  "faq_content",
                  "source_note",
                  "call_to_action"
                ]
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "heading_level": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 2,
                "maximum": 4
              },
              "content": {
                "type": "object"
              },
              "product_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "uniqueItems": true
              },
              "claim_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "block_key",
              "block_type",
              "position",
              "content"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "locale",
        "title",
        "blocks"
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "block_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "claim_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "criticality": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "claim_key",
          "block_key",
          "claim_type",
          "claim_text",
          "criticality",
          "fact_ids"
        ]
      }
    },
    "product_recommendations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rationale_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "suitable_for": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "unsuitable_for": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "required": [
          "product_id",
          "rank",
          "rationale_fact_ids",
          "suitable_for",
          "unsuitable_for"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "article",
    "claims",
    "product_recommendations",
    "warnings"
  ]
}
