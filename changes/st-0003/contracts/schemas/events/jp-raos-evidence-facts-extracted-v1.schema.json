{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/events/jp-raos-evidence-facts-extracted-v1.schema.json",
  "title": "jp.raos.evidence.facts_extracted.v1",
  "description": "Fact候補が抽出された。",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "jp.raos.evidence.facts_extracted.v1"
        },
        "producer": {
          "const": "evidence"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_snapshot_id": {
              "type": "string",
              "format": "uuid"
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "extractor_version": {
              "type": "string"
            },
            "manual_review_required_count": {
              "type": "integer"
            }
          },
          "required": [
            "source_snapshot_id",
            "fact_ids",
            "extractor_version",
            "manual_review_required_count"
          ]
        }
      }
    }
  ]
}
