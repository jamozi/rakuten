{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/jobs/analytics-rollup-daily-metrics-v1.schema.json",
  "title": "analytics.rollup_daily_metrics.v1",
  "description": "GSC、GA4、first-party clickをArticle日次指標へ集計する。",
  "allOf": [
    {
      "$ref": "../common/job-message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "job_type": {
          "const": "analytics.rollup_daily_metrics.v1"
        },
        "queue": {
          "const": "analytics"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "site_id": {
              "type": "string",
              "format": "uuid"
            },
            "date_from": {
              "type": "string",
              "format": "date"
            },
            "date_to": {
              "type": "string",
              "format": "date"
            },
            "calculation_version": {
              "type": "string"
            }
          },
          "required": [
            "site_id",
            "date_from",
            "date_to",
            "calculation_version"
          ]
        }
      }
    }
  ]
}
