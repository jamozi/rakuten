{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/jobs/ops-export-audit-v1.schema.json",
  "title": "ops.export_audit.v1",
  "description": "Audit Eventをhash付きArtifactへexportする。",
  "allOf": [
    {
      "$ref": "../common/job-message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "job_type": {
          "const": "ops.export_audit.v1"
        },
        "queue": {
          "const": "analytics"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "date_from": {
              "type": "string",
              "format": "date-time"
            },
            "date_to": {
              "type": "string",
              "format": "date-time"
            },
            "format": {
              "type": "string",
              "enum": [
                "JSONL",
                "CSV"
              ]
            },
            "filters": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "date_from",
            "date_to",
            "format"
          ]
        }
      }
    }
  ]
}
