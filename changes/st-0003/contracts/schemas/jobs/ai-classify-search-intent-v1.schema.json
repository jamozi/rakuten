{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/jobs/ai-classify-search-intent-v1.schema.json",
  "title": "ai.classify_search_intent.v1",
  "description": "Keyword群を検索意図へ構造化分類する。",
  "allOf": [
    {
      "$ref": "../common/job-message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "job_type": {
          "const": "ai.classify_search_intent.v1"
        },
        "queue": {
          "const": "ai"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_packet_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "keyword_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 500
            },
            "prompt_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "model_route_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "output_schema_version_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "source_packet_version_id",
            "keyword_ids",
            "prompt_version_id",
            "model_route_version_id",
            "output_schema_version_id"
          ]
        }
      }
    }
  ]
}
