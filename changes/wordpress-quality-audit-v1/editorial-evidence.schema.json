{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurashinoshirube.com/contracts/editorial-evidence.schema.json",
  "title": "暮らしのしるべ 第三者報告・実機確認証跡",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "reviewed_on", "article_modes", "records"],
  "properties": {
    "schema": {"const": "RAOS_EDITORIAL_EVIDENCE_REGISTER_V1"},
    "version": {"const": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "article_modes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_slug", "evidence_mode"],
        "properties": {
          "article_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"},
          "evidence_mode": {"const": "OFFICIAL_SPEC_COMPARISON_NON_HANDS_ON"}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/thirdPartyReport"},
          {"$ref": "#/$defs/editorialHandsOn"}
        ]
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,95}$"},
        "article_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"},
        "exact_model": {"type": "string", "minLength": 1},
        "checked_date": {"type": "string", "format": "date"}
      }
    },
    "thirdPartyReport": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "evidence_kind",
            "article_slug",
            "exact_model",
            "publisher",
            "published_date",
            "checked_date",
            "usage_conditions",
            "source_url",
            "locator",
            "attribution_label",
            "recommendation_use",
            "review_label_use",
            "best_claim_use"
          ],
          "properties": {
            "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,95}$"},
            "evidence_kind": {"const": "THIRD_PARTY_REPORT"},
            "article_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"},
            "exact_model": {"type": "string", "minLength": 1},
            "publisher": {"type": "string", "minLength": 1},
            "published_date": {"type": "string", "format": "date"},
            "checked_date": {"type": "string", "format": "date"},
            "usage_conditions": {"type": "string", "minLength": 1},
            "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "locator": {"type": "string", "minLength": 1},
            "attribution_label": {"const": "第三者による報告"},
            "recommendation_use": {"const": false},
            "review_label_use": {"const": false},
            "best_claim_use": {"const": false}
          }
        }
      ]
    },
    "editorialHandsOn": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "evidence_kind",
            "article_slug",
            "exact_model",
            "checked_date",
            "direct_use_confirmed",
            "acquisition_route",
            "provided_or_loaned",
            "conflict_disclosure",
            "usage_start_date",
            "usage_end_date",
            "usage_environment",
            "verification_method",
            "original_device_evidence_refs"
          ],
          "properties": {
            "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,95}$"},
            "evidence_kind": {"const": "EDITORIAL_HANDS_ON"},
            "article_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"},
            "exact_model": {"type": "string", "minLength": 1},
            "checked_date": {"type": "string", "format": "date"},
            "direct_use_confirmed": {"const": true},
            "acquisition_route": {"type": "string", "minLength": 1},
            "provided_or_loaned": {"type": "boolean"},
            "conflict_disclosure": {"type": "string", "minLength": 1},
            "usage_start_date": {"type": "string", "format": "date"},
            "usage_end_date": {"type": "string", "format": "date"},
            "usage_environment": {"type": "string", "minLength": 1},
            "verification_method": {"type": "string", "minLength": 1},
            "original_device_evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "path", "sha256"],
                "properties": {
                  "kind": {"enum": ["PHOTO", "VIDEO", "AUDIO", "MEASUREMENT_LOG"]},
                  "path": {"type": "string", "pattern": "^evidence/[A-Za-z0-9][A-Za-z0-9._/-]{1,220}$"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
