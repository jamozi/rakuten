{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/common/artifact-ref.schema.json",
  "title": "ArtifactRef",
  "description": "Object Storage上の不変Artifact参照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "sha256"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "uri": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(s3|file)://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "byte_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
