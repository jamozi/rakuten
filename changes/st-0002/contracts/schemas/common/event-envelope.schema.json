{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/common/event-envelope.schema.json",
  "title": "RAOS Domain Event Envelope",
  "description": "CloudEvents互換フィールドを含む不変Domain Event。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "event_version",
    "producer",
    "aggregate",
    "correlation_id",
    "actor",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "format": "uri-reference",
      "pattern": "^urn:raos:"
    },
    "type": {
      "type": "string",
      "pattern": "^jp\\.raos\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
    },
    "subject": {
      "type": "string",
      "pattern": "^urn:raos:[a-z0-9_]+:[0-9a-f-]{36}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri-reference"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "actor": {
      "$ref": "actor-ref.schema.json"
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "default": "INTERNAL"
    },
    "partition_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "data": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "local",
            "test",
            "staging",
            "production"
          ]
        },
        "release_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "replay": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
