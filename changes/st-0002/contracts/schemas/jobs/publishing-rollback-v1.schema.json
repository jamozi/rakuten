{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/jobs/publishing-rollback-v1.schema.json",
  "title": "publishing.rollback.v1",
  "description": "検証済み旧SnapshotへRollbackする。",
  "allOf": [
    {
      "$ref": "../common/job-message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "job_type": {
          "const": "publishing.rollback.v1"
        },
        "queue": {
          "const": "publication"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publication_id": {
              "type": "string",
              "format": "uuid"
            },
            "from_snapshot_id": {
              "type": "string",
              "format": "uuid"
            },
            "to_snapshot_id": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string"
            },
            "incident_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "verification_required": {
              "type": "boolean"
            }
          },
          "required": [
            "publication_id",
            "from_snapshot_id",
            "to_snapshot_id",
            "reason"
          ]
        }
      }
    }
  ]
}
