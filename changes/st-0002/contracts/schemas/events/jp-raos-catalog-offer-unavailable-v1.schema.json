{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/events/jp-raos-catalog-offer-unavailable-v1.schema.json",
  "title": "jp.raos.catalog.offer_unavailable.v1",
  "description": "Offerが利用不能と判断された。",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "jp.raos.catalog.offer_unavailable.v1"
        },
        "producer": {
          "const": "catalog"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offer_id": {
              "type": "string",
              "format": "uuid"
            },
            "reason_code": {
              "type": "string"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "alternative_search_required": {
              "type": "boolean"
            }
          },
          "required": [
            "offer_id",
            "reason_code",
            "observed_at",
            "alternative_search_required"
          ]
        }
      }
    }
  ]
}
