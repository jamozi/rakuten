{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/events/jp-raos-finance-revenue-import-dry-run-ready-v1.schema.json",
  "title": "jp.raos.finance.revenue_import_dry_run_ready.v1",
  "description": "Revenue Import Previewが人間確認可能になった。",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "jp.raos.finance.revenue_import_dry_run_ready.v1"
        },
        "producer": {
          "const": "finance"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revenue_import_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "accepted_count": {
              "type": "integer"
            },
            "rejected_count": {
              "type": "integer"
            },
            "commission_amount_jpy": {
              "type": "integer"
            },
            "reconciliation_status": {
              "type": "string"
            },
            "report_artifact": {
              "$ref": "../common/artifact-ref.schema.json"
            }
          },
          "required": [
            "revenue_import_id",
            "source_sha256",
            "accepted_count",
            "rejected_count",
            "commission_amount_jpy",
            "reconciliation_status",
            "report_artifact"
          ]
        }
      }
    }
  ]
}
