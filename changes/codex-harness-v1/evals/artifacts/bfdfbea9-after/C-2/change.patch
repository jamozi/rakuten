index 0000000..0e1830f
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    value = step.result.projection()
+    # Supply a synthetic update time in the existing nullable public field.
+    article = cast(dict[str, object], value["article"])
+    article["updated_public_at"] = "2026-09-06T09:00:00Z"
+    return value
+
+
+@pytest.mark.parametrize("status", ["FRESH", "STALE", "UNKNOWN", "UNAVAILABLE"])
+def test_renders_public_values_without_mutating_projection(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T09:00:00Z / 状態: {status}"
+    )
+    assert projection == before
+
+
+def test_escapes_html_and_quotes_in_both_public_fields(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time datetime="now">&\'</time>'
+    article["freshness_status"] = 'UNKNOWN<script>alert("x" & \'y\')</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time datetime=&quot;now&quot;&gt;&amp;&#x27;&lt;/time&gt;"
+        " / 状態: UNKNOWN&lt;script&gt;alert(&quot;x&quot; &amp; &#x27;y&#x27;)"
+        "&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_public_field_raises_value_error(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, [], {}])
+def test_empty_or_non_string_public_field_raises_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [None, [], "invalid", {}, {"article": None}, {"article": []}, {"article": "invalid"}],
+)
+def test_missing_or_invalid_projection_article_raises_value_error(value: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], value))
+
+
+def test_ignores_unrelated_synthetic_metadata(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    projection["evidence"] = {"updated_public_at": "synthetic-unapproved-update"}
+    projection["finance"] = {"freshness_status": "synthetic-private-status"}
+    article["source_note"] = "synthetic unrelated text"
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T09:00:00Z / 状態: UNKNOWN"
+    )
+    assert projection == before
+
+
+def test_recorded_null_update_has_no_fallback(step: RecordedPublicProjectionStep) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    assert article["updated_public_at"] is None
+    assert article["published_at"]
+    projection["updated_public_at"] = "2026-09-06T09:00:00Z"
+    projection["evidence"] = {"updated_public_at": "2026-09-06T09:00:00Z"}
+    projection["finance"] = {"updated_public_at": "2026-09-06T09:00:00Z"}
+    before = deepcopy(projection)
+
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
+    assert projection == before
