 from tools.affiliate_ingestion.client import FetchBatch, RawPage, parse_records
@@ -153,6 +155,93 @@ class NormalizationAndStorageTests(unittest.TestCase):
             self.assertTrue(normalized_path.is_file())
 
 
+@pytest.mark.parametrize(
+    "value,expected_amount",
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero_values(value, expected_amount):
+    source = {"id": value, "price": value, "commission": value}
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == value
+    assert type(normalized["source_id"]) is type(value)
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize(
+    "first,second,expected_amount", [(0, 123, "0"), (123, 0, "123")]
+)
+def test_normalization_keeps_alias_priority_with_zero(first, second, expected_amount):
+    # Insert the lower-priority aliases first to distinguish alias from input order.
+    source = {
+        "product_id": second,
+        "id": first,
+        "unit_price": second,
+        "price": first,
+        "reward": second,
+        "commission": first,
+    }
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == first
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+
+
+@pytest.mark.parametrize(
+    "source",
+    [{}]
+    + [
+        {"id": value, "price": value, "commission": value}
+        for value in (None, "", False, [], {})
+    ],
+    ids=["missing", "null", "empty-string", "false", "empty-list", "empty-dict"],
+)
+def test_normalization_keeps_empty_values_missing_and_falls_back_to_zero(source):
+    missing = normalize_record("a8net", "products", source)
+    assert missing["source_id"] is None
+    assert missing["price"] is None
+    assert missing["commission"] is None
+
+    normalized = normalize_record(
+        "a8net", "products", {**source, "product_id": 0, "unit_price": 0, "reward": 0}
+    )
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+@pytest.mark.parametrize(
+    "source,seed",
+    [
+        ({"id": 0}, b'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}'),
+        ({"id": "P-1"}, b'a8net\x1fproducts\x1fP-1\x1f\x1f{"id": "P-1"}'),
+        ({}, b"a8net\x1fproducts\x1f\x1f\x1f{}"),
+    ],
+)
+def test_normalization_fingerprint_keeps_source_id(source, seed):
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["fingerprint_sha256"] == hashlib.sha256(seed).hexdigest()
+
+
+def test_persist_batch_keeps_zero_values_in_normalized_ndjson(tmp_path):
+    payload = b'[{"id": 0, "price": 0, "commission": 0}]'
+    records, _ = parse_records(payload, configured_format="json")
+    batch = FetchBatch(
+        "a8net",
+        "products",
+        "2026-09-05T00:00:00+00:00",
+        records,
+        [RawPage(1, "https://example.invalid/feed", "application/json", payload, 200)],
+    )
+    manifest = persist_batch(batch, {"root": str(tmp_path)})
+    normalized = json.loads((tmp_path / manifest["normalized_path"]).read_text())
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+    assert normalized["raw"] == records[0]
+
+
