+@pytest.mark.parametrize("custom_path", [False, True])
+@pytest.mark.parametrize("terminal_link", [None, {"href": None}])
+def test_recorded_next_link_pages_normalize_rewards(tmp_path, custom_path, terminal_link):
+    config = ready_config()
+    pagination = {"type": "next_link", "max_pages": 3}
+    config["providers"]["a8net"]["resources"]["products"]["pagination"] = pagination
+    first_record = {"id": "1", "reward_jpy": "¥1,234", "status": "pending"}
+    last_record = {"id": "2", "reward_jpy": 0, "status": "approved"}
+    first = {
+        "items": [first_record],
+        "links": {"next": {"href": "page-2?cursor=second"}},
+    }
+    last = {"items": [last_record], "links": {"next": terminal_link}}
+    if custom_path:
+        pagination["next_url_path"] = "paging.follow.href"
+        first["paging"] = {"follow": first["links"]["next"]}
+        last["paging"] = {"follow": terminal_link}
+        # An explicit path must take precedence over the default path.
+        first["links"]["next"] = {"href": "https://other.invalid/feed"}
+        last["links"]["next"] = {"href": "https://other.invalid/feed"}
+    first_url = "https://example.invalid/recorded/page-1"
+    last_url = "https://example.invalid/recorded/page-2?cursor=second"
+    with (
+        patch.object(
+            AffiliateHttpClient,
+            "request",
+            side_effect=[response(first, first_url), response(last, last_url)],
+        ) as request,
+        patch.object(EndpointValidator, "validate") as validate,
+    ):
+        batch = fetch_resource(config, "a8net", "products")
+    assert [call.args[0] for call in request.call_args_list] == [
+        "https://example.invalid/products",
+        last_url,
+    ]
+    validate.assert_called_once_with(last_url)
+    assert batch.records == [first_record, last_record]
+    assert [page.index for page in batch.pages] == [1, 2]
+    assert batch.warnings == []
+
+    manifest = persist_batch(batch, {"root": str(tmp_path)})
+    normalized = [
+        json.loads(line)
+        for line in (tmp_path / manifest["normalized_path"]).read_text().splitlines()
+    ]
+    assert [record["commission"] for record in normalized] == ["1234", "0"]
+    assert [record["status"] for record in normalized] == ["pending", "approved"]
+    assert all(record["approved_at"] is None for record in normalized)
+    assert [record["raw"] for record in normalized] == [first_record, last_record]
+
