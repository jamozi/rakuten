@@ -0,0 +1,27 @@
+"""Render update metadata from an existing public projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+from typing import cast
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text; missing, blank or non-text values are invalid."""
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+    public_article = cast(Mapping[str, object], article)
+    updated_public_at = public_article.get("updated_public_at")
+    freshness_status = public_article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-blank string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-blank string")
+    return (
+        f"更新: {escape(updated_public_at, quote=True)} / "
+        f"状態: {escape(freshness_status, quote=True)}"
+    )
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..366c900
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from types import MappingProxyType
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    result = step.result.projection()
+    article = cast(dict[str, object], result["article"])
+    article["updated_public_at"] = "2026-09-06T01:02:03Z"
+    return result
+
+
+@pytest.mark.parametrize("status", ["UNKNOWN", "FRESH", "STALE", "確認中"])
+def test_notice_uses_public_values_without_mutating_projection(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T01:02:03Z / 状態: {status}"
+    )
+    assert projection == before
+
+
+def test_notice_accepts_read_only_public_mappings(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    projection["article"] = MappingProxyType(article)
+
+    assert render_public_update_notice(MappingProxyType(projection)) == (
+        "更新: 2026-09-06T01:02:03Z / 状態: UNKNOWN"
+    )
+
+
+def test_notice_escapes_html_in_both_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time title="x">&\'</time>'
+    article["freshness_status"] = '<script title="x">&\'</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;x&quot;&gt;&amp;&#x27;&lt;/time&gt; / "
+        "状態: &lt;script title=&quot;x&quot;&gt;&amp;&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_public_value_raises_value_error(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+    # Synthetic decoys must not become fallback sources for a public value.
+    projection[field] = "top-level-decoy"
+    article["evidence"] = {field: "synthetic-evidence-decoy"}
+    article["finance"] = {field: "synthetic-finance-decoy"}
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, True, [], {}])
+def test_invalid_public_value_raises_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("article", [None, "invalid", [], 0])
+def test_invalid_article_raises_value_error(article: object) -> None:
+    with pytest.raises(ValueError, match=r"projection\.article"):
+        render_public_update_notice({"article": article})
+
+
+def test_missing_article_raises_value_error() -> None:
+    with pytest.raises(ValueError, match=r"projection\.article"):
+        render_public_update_notice({})
+
+
+@pytest.mark.parametrize("projection", [None, "invalid", []])
+def test_invalid_projection_raises_value_error(projection: object) -> None:
+    with pytest.raises(ValueError, match="projection must be a mapping"):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_recorded_projection_does_not_invent_an_update_time(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    assert article["updated_public_at"] is None
+    assert article["published_at"]
+
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
