+@pytest.mark.parametrize(
+    "zero,decimal_text",
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero_values(zero, decimal_text):
+    source = {"id": zero, "price": zero, "commission": zero}
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == zero
+    assert normalized["price"] == decimal_text
+    assert normalized["commission"] == decimal_text
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("primary,secondary,expected", [(0, 12, 0), (12, 0, 12)])
+def test_normalization_preserves_alias_priority(primary, secondary, expected):
+    source = {
+        "product_id": secondary,
+        "unit_price": secondary,
+        "reward": secondary,
+        "id": primary,
+        "price": primary,
+        "commission": primary,
+    }
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == expected
+    assert normalized["price"] == str(expected)
+    assert normalized["commission"] == str(expected)
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, ()])
+def test_normalization_skips_empty_aliases_before_zero(empty):
+    source = {"id": empty, "price": empty, "commission": empty}
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] is None
+    assert normalized["price"] is None
+    assert normalized["commission"] is None
+
+    source.update({"Product-ID": 0, "Unit Price": 0, "Reward": 0})
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+def test_normalization_preserves_whitespace_alias_values():
+    normalized = normalize_record(
+        "a8net",
+        "products",
+        {"id": " ", "product_id": 12, "price": " ", "unit_price": 12},
+    )
+    assert normalized["source_id"] == " "
+    assert normalized["price"] == " "
+
+
+@pytest.mark.parametrize(
+    "source,expected_fingerprint",
+    [
+        ({"id": 0}, "c9f03aa8eea5d256d54819df16fe0e633018ee674c93f1e8e335e6df1c6b7854"),
+        (
+            {"id": 12},
+            "2119670e782ae0fba769cc74c60cb11485e9a7c76e63ccf766b38c8a7cca57b4",
+        ),
+        ({}, "d9be640685e7c7113bb77273dabb92b1f1222d59214364a06124eb5348d0633d"),
+    ],
+)
+def test_normalization_fingerprint_preserves_zero_and_existing_ids(
+    source, expected_fingerprint
+):
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["fingerprint_sha256"] == expected_fingerprint
+
+
