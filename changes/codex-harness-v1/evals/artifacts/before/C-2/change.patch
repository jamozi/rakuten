index 0000000..371ad6c
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,31 @@
+"""Render update information from an existing public projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text, requiring both public article values.
+
+    Missing, null, blank, or non-string values raise ValueError. Values are
+    displayed as supplied; no timestamp or freshness status is inferred.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("public projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("public projection must contain an article mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-empty string")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-empty string")
+
+    return (
+        f"更新: {escape(updated_public_at, quote=True)} / "
+        f"状態: {escape(freshness_status, quote=True)}"
+    )
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..b3a53ff
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "2026-08-25T10:11:12Z"
+    return projection
+
+
+def test_renders_public_values_without_mutating_projection(
+    projection: dict[str, object],
+) -> None:
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-08-25T10:11:12Z / 状態: UNKNOWN"
+    )
+    assert projection == before
+
+
+def test_escapes_html_characters_in_both_values(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time title="更新">2026 & \'26</time>'
+    article["freshness_status"] = '<script>"状態" & \'unknown\'</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;更新&quot;&gt;2026 &amp; &#x27;26&lt;/time&gt; / "
+        "状態: &lt;script&gt;&quot;状態&quot; &amp; &#x27;unknown&#x27;&lt;/script&gt;"
+    )
+
+
+def test_preserves_public_timestamp_and_status_text(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "2026-08-25T19:11:12+09:00"
+    article["freshness_status"] = "STALE"
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-08-25T19:11:12+09:00 / 状態: STALE"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_public_value_raises_value_error(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, [], {}])
+def test_unavailable_or_invalid_public_value_raises_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("projection", [{}, {"article": None}, {"article": []}])
+def test_missing_or_invalid_article_raises_value_error(
+    projection: dict[str, object],
+) -> None:
+    with pytest.raises(ValueError, match="article"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("projection", [None, [], "not-a-projection"])
+def test_invalid_projection_raises_value_error(projection: object) -> None:
+    with pytest.raises(ValueError, match="projection"):
+        render_public_update_notice(projection)  # type: ignore[arg-type]
+
+
+def test_recorded_projection_without_public_update_is_unavailable(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_unrelated_fields_cannot_supply_missing_public_value(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+    # Malformed synthetic input must not become an alternate public data path.
+    projection[field] = "synthetic-top-level-fallback"
+    for container in (projection, article):
+        container["evidence"] = {field: "synthetic-evidence-fallback"}
+        container["finance"] = {field: "synthetic-finance-fallback"}
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
