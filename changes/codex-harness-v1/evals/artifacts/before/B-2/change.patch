+def test_next_link_aggregate_response_limit_stops_fetch():
+    config = ready_config()
+    page = response({"items": [{"id": "1"}], "links": {"next": {"href": "?page=2"}}})
+    config["storage"]["max_uncompressed_bytes"] = len(page[2]) * 2 - 1
+    config["providers"]["a8net"]["resources"]["products"]["pagination"] = {
+        "type": "next_link",
+        "max_pages": 3,
+    }
+    with (
+        patch.object(AffiliateHttpClient, "request", return_value=page) as request,
+        patch.object(EndpointValidator, "validate"),
+    ):
+        with pytest.raises(FetchError, match="batch exceeds max_uncompressed_bytes"):
+            fetch_resource(config, "a8net", "products")
+    assert request.call_count == 2
