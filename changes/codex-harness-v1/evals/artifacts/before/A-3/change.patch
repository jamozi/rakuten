+@pytest.mark.parametrize(
+    "zero,expected_amount",
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero_values(zero, expected_amount):
+    source = {"product_id": zero, "unit_price": zero, "reward": zero}
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == zero
+    assert type(normalized["source_id"]) is type(zero)
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize(
+    "preferred,fallback,expected_amount",
+    [(0, 42, "0"), (42, 0, "42"), ("0", 42, "0"), (" \t ", 42, " \t ")],
+)
+def test_normalization_preserves_alias_priority(preferred, fallback, expected_amount):
+    # Input order must not override the established alias priority.
+    source = {
+        "product_id": fallback,
+        "id": preferred,
+        "unit_price": fallback,
+        "price": preferred,
+        "reward": fallback,
+        "commission": preferred,
+    }
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == preferred
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, (), b""])
+def test_normalization_preserves_empty_value_fallback(empty):
+    source = {"id": empty, "price": empty, "commission": empty}
+    for record in ({}, source):
+        normalized = normalize_record("a8net", "products", record)
+        for field in ("source_id", "price", "commission"):
+            assert normalized[field] is None
+
+    source.update(
+        program_id=0, product_id=42, unit_price=0, amount=42, reward=0, fee=42
+    )
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+@pytest.mark.parametrize(
+    "source_id,expected_id", [(0, "0"), (0.0, "0.0"), ("P-1", "P-1"), (None, "")]
+)
+def test_normalization_fingerprint_includes_source_id(source_id, expected_id):
+    source = {"id": source_id}
+    normalized = normalize_record("a8net", "products", source)
+    expected_seed = "\x1f".join(
+        ["a8net", "products", expected_id, "", json.dumps(source, sort_keys=True)]
+    )
+    assert normalized["fingerprint_sha256"] == hashlib.sha256(
+        expected_seed.encode("utf-8")
+    ).hexdigest()
+
+
