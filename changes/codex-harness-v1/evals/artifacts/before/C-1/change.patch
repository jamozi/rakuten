@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    document = step.result.projection()
+    article = cast(dict[str, object], document["article"])
+    # Synthetic display input only; the recorded artifact remains unchanged.
+    article["updated_public_at"] = "2026-09-06T10:00:00+09:00"
+    return document
+
+
+@pytest.mark.parametrize("status", ["FRESH", "STALE", "UNKNOWN"])
+def test_renders_existing_projection_without_mutation(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T10:00:00+09:00 / 状態: {status}"
+    )
+    assert projection == before
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_escapes_html_in_both_display_values(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = '<script>"&\'</script>'
+    escaped = "&lt;script&gt;&quot;&amp;&#x27;&lt;/script&gt;"
+    expected = (
+        f"更新: {escaped} / 状態: UNKNOWN"
+        if field == "updated_public_at"
+        else f"更新: 2026-09-06T10:00:00+09:00 / 状態: {escaped}"
+    )
+
+    assert render_public_update_notice(projection) == expected
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_required_field_raises_value_error(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", False, 123, [], {}])
+def test_unavailable_or_non_text_value_raises_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "document", [{}, {"article": None}, {"article": []}, {"article": "invalid"}]
+)
+def test_missing_or_malformed_article_raises_value_error(
+    document: dict[str, object],
+) -> None:
+    with pytest.raises(ValueError, match=r"projection\.article"):
+        render_public_update_notice(document)
+
+
+@pytest.mark.parametrize("document", [None, [], "invalid", 123])
+def test_malformed_projection_raises_value_error(document: object) -> None:
+    with pytest.raises(ValueError, match="public projection"):
+        render_public_update_notice(cast(Mapping[str, object], document))
+
+
+def test_recorded_projection_does_not_invent_update_information(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_only_public_article_fields_supply_the_notice(field: str) -> None:
+    article = {
+        "updated_public_at": "2026-09-06T01:00:00Z",
+        "freshness_status": "UNKNOWN",
+    }
+    # Synthetic decoys demonstrate isolation, not an accepted public API shape.
+    document: dict[str, object] = {
+        "article": article,
+        "updated_public_at": "unused-top-level-date",
+        "freshness_status": "unused-top-level-status",
+        "evidence": {"updated_public_at": "unused-evidence-date"},
+        "finance": {"freshness_status": "unused-finance-status"},
+    }
+    assert render_public_update_notice(document) == (
+        "更新: 2026-09-06T01:00:00Z / 状態: UNKNOWN"
+    )
+
+    del article[field]
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(document)
