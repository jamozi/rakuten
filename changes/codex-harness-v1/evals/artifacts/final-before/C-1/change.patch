index 0000000..039d7c1
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,31 @@
+"""HTML-safe update notices from the existing public article projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Render public update metadata, raising ValueError if either value is absent.
+
+    Required values must be non-blank strings. No dates or statuses are inferred
+    when the public projection does not supply them.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("public projection must contain an article mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("public projection must contain an article mapping")
+
+    updated_public_at: object = article.get("updated_public_at")
+    freshness_status: object = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-blank string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-blank string")
+
+    return f"更新: {escape(updated_public_at)} / 状態: {escape(freshness_status)}"
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..e52f63f
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    result = step.result.projection()
+    article = cast(dict[str, object], result["article"])
+    article["updated_public_at"] = "2026-09-06T00:00:00Z"
+    return result
+
+
+def test_renders_existing_public_fields_without_mutating_projection(
+    projection: dict[str, object],
+) -> None:
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z / 状態: UNKNOWN"
+    )
+    assert projection == original
+
+
+def test_escapes_html_in_both_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = """<time data-note="updated">'&</time>"""
+    article["freshness_status"] = """<b data-status="stale">'&</b>"""
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time data-note=&quot;updated&quot;&gt;&#x27;&amp;&lt;/time&gt;"
+        " / 状態: &lt;b data-status=&quot;stale&quot;&gt;&#x27;&amp;&lt;/b&gt;"
+    )
+
+
+def test_recorded_projection_without_update_date_has_no_publication_date_fallback(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    original = deepcopy(projection)
+
+    with pytest.raises(ValueError, match="article.updated_public_at"):
+        render_public_update_notice(projection)
+    assert projection == original
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [
+        None,
+        [],
+        {},
+        {"article": None},
+        {"article": []},
+        {"article": "unavailable"},
+        {"updated_public_at": "2026-09-06T00:00:00Z", "freshness_status": "UNKNOWN"},
+    ],
+)
+def test_requires_nested_article_mapping(projection: object) -> None:
+    with pytest.raises(ValueError, match="article"):
+        render_public_update_notice(projection)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_article_value_does_not_fall_back_to_top_level(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    projection[field] = article.pop(field)
+
+    with pytest.raises(ValueError, match=field):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, {}, []])
+def test_rejects_unavailable_or_non_text_values(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=field):
+        render_public_update_notice(projection)
+
+
+def test_unrelated_fields_are_not_rendered(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["title"] = "<script>unexpected_title()</script>"
+    article["excerpt"] = "unrelated article excerpt"
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z / 状態: UNKNOWN"
+    )
