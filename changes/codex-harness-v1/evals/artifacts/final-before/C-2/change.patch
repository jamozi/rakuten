@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "2030-01-02T03:04:05+09:00"
+    return projection
+
+
+@pytest.mark.parametrize("status", ("UNKNOWN", "FRESH", "STALE", "要確認"))
+def test_renders_public_metadata_without_mutating_projection(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2030-01-02T03:04:05+09:00 / 状態: {status}"
+    )
+    assert projection == before
+
+
+def test_escapes_html_in_both_display_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time title="updated">&\'</time>'
+    article["freshness_status"] = '<b title="status">&\'</b>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;updated&quot;&gt;&amp;&#x27;&lt;/time&gt; / "
+        "状態: &lt;b title=&quot;status&quot;&gt;&amp;&#x27;&lt;/b&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ("updated_public_at", "freshness_status"))
+def test_missing_value_does_not_fall_back_to_other_metadata(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+    # Malformed synthetic inputs must not become alternate data sources.
+    projection[field] = "synthetic-top-level-value"
+    for key in ("evidence", "finance"):
+        article[key] = {field: "synthetic-internal-value"}
+        projection[key] = {field: "synthetic-internal-value"}
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ("updated_public_at", "freshness_status"))
+@pytest.mark.parametrize("value", (None, "", " \t\n", 0, False, [], {}))
+def test_unavailable_or_non_string_values_raise_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("value", (None, [], "article", 0))
+def test_invalid_article_raises_value_error(value: object) -> None:
+    with pytest.raises(ValueError, match="article mapping"):
+        render_public_update_notice({"article": value})
+
+
+@pytest.mark.parametrize("value", (None, [], "projection", 0, {}))
+def test_missing_projection_or_article_raises_value_error(value: object) -> None:
+    with pytest.raises(ValueError, match="article mapping"):
+        render_public_update_notice(cast(Mapping[str, object], value))
+
+
+def test_recorded_projection_without_update_time_is_not_fabricated(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    before = deepcopy(projection)
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
+    assert projection == before
+
+
+def test_unrelated_values_are_not_rendered(projection: dict[str, object]) -> None:
+    class Unrenderable:
+        def __str__(self) -> str:
+            raise AssertionError("unrelated values must not be rendered")
+
+    article = cast(dict[str, object], projection["article"])
+    article["title"] = Unrenderable()
+    projection["route"] = Unrenderable()
+    assert render_public_update_notice(projection) == (
+        "更新: 2030-01-02T03:04:05+09:00 / 状態: UNKNOWN"
+    )
