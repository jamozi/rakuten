+@pytest.mark.parametrize("terminal_link", [None, {"href": None}])
+def test_next_link_relative_pages_and_reward_normalization(tmp_path, terminal_link):
     config = ready_config()
+    provider = config["providers"]["a8net"]
+    provider["auth"] = {"type": "bearer", "token": "synthetic"}
+    provider["resources"]["products"]["pagination"] = {
+        "type": "next_link",
+        "max_pages": 5,
+    }
+    first_record = {"id": "1", "reward_jpy": "￥1,200"}
+    last_record = {"id": "2", "reward_jpy": 0}
+    second_url = "https://example.invalid/api/pages/second?page=2"
+    third_url = "https://example.invalid/api/pages/second?page=3"
+    with (
+        patch.object(
+            AffiliateHttpClient,
+            "request",
+            side_effect=[
+                response(
+                    {
+                        "items": [first_record],
+                        "links": {"next": {"href": "pages/second?page=2"}},
+                    },
+                    url="https://example.invalid/api/products?page=1",
+                ),
+                response(
+                    {"items": [], "links": {"next": {"href": "?page=3"}}},
+                    url=second_url,
+                ),
+                response(
+                    {"items": [last_record], "links": {"next": terminal_link}},
+                    url=third_url,
+                ),
+            ],
+        ) as request,
+        patch.object(EndpointValidator, "validate") as validate,
+    ):
+        batch = fetch_resource(config, "a8net", "products")
+    assert [call.args[0] for call in request.call_args_list] == [
+        "https://example.invalid/products",
+        second_url,
+        third_url,
+    ]
+    assert [call.args[0] for call in validate.call_args_list] == [second_url, third_url]
+    assert all(
+        call.kwargs["headers"]["Authorization"] == "Bearer synthetic"
+        for call in request.call_args_list
+    )
+    assert batch.records == [first_record, last_record]
+    assert len(batch.pages) == 3
+    assert batch.warnings == []
+    manifest = persist_batch(batch, {"root": str(tmp_path)})
+    normalized = [
+        json.loads(line)
+        for line in (tmp_path / manifest["normalized_path"]).read_text().splitlines()
+    ]
+    assert [record["commission"] for record in normalized] == ["1200", "0"]
+    assert [record["raw"] for record in normalized] == batch.records
