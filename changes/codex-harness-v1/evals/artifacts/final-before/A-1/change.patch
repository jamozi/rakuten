+@pytest.mark.parametrize(
+    ("zero", "expected_amount"),
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero(zero, expected_amount):
+    source = {"id": zero, "price": zero, "commission": zero}
+
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == zero
+    assert type(normalized["source_id"]) is type(zero)
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize(
+    ("field", "primary", "secondary"),
+    [
+        ("source_id", "id", "product_id"),
+        ("price", "price", "unit_price"),
+        ("commission", "commission", "reward"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("primary_value", "secondary_value", "expected"),
+    [
+        (0, 9, 0),
+        (9, 0, 9),
+        (None, 0, 0),
+        ("", 0, 0),
+        (False, 0, 0),
+        ([], 0, 0),
+        ({}, 0, 0),
+        (" ", 9, " "),
+    ],
+)
+def test_normalization_preserves_alias_priority(
+    field, primary, secondary, primary_value, secondary_value, expected
+):
+    # Input key order must not override the configured alias order.
+    source = {secondary: secondary_value, primary: primary_value}
+
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized[field] == (expected if field == "source_id" else str(expected))
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}])
+def test_normalization_preserves_empty_values(empty):
+    source = dict.fromkeys(
+        ("id", "product_id", "price", "unit_price", "commission", "reward"), empty
+    )
+
+    for record in ({}, source):
+        normalized = normalize_record("a8net", "products", record)
+
+        assert normalized["source_id"] is None
+        assert normalized["price"] is None
+        assert normalized["commission"] is None
+
+
