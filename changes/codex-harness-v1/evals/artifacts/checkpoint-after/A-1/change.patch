+    def test_normalization_preserves_zero_values_and_their_priority(self) -> None:
+        for zero, money in [
+            (0, "0"),
+            (0.0, "0.0"),
+            (Decimal("0.00"), "0.00"),
+            ("0", "0"),
+        ]:
+            for fallbacks in [
+                {},
+                {"product_id": "P-1", "unit_price": "1200", "reward": "100"},
+            ]:
+                with self.subTest(zero=zero, fallbacks=fallbacks):
+                    source = {**fallbacks, "id": zero, "price": zero, "commission": zero}
+                    normalized = normalize_record("a8net", "products", source)
+                    self.assertEqual(normalized["source_id"], zero)
+                    self.assertEqual(normalized["price"], money)
+                    self.assertEqual(normalized["commission"], money)
+                    self.assertEqual(normalized["raw"], source)
+
+    def test_empty_aliases_remain_missing(self) -> None:
+        for empty in [None, "", False, [], {}, ()]:
+            with self.subTest(empty=empty):
+                normalized = normalize_record(
+                    "a8net",
+                    "products",
+                    {"id": empty, "price": empty, "commission": empty},
+                )
+                self.assertIsNone(normalized["source_id"])
+                self.assertIsNone(normalized["price"])
+                self.assertIsNone(normalized["commission"])
+
+    def test_empty_aliases_fall_back_to_zero_in_existing_order(self) -> None:
+        for empty in [None, "", False, [], {}, ()]:
+            with self.subTest(empty=empty):
+                source = {
+                    "product_id": "P-1",
+                    "program_id": 0,
+                    "id": empty,
+                    "amount": "1200",
+                    "unit_price": 0,
+                    "price": empty,
+                    "reward": "100",
+                    "commission_amount": 0,
+                    "commission": empty,
+                }
+                normalized = normalize_record("a8net", "products", source)
+                self.assertEqual(normalized["source_id"], 0)
+                self.assertEqual(normalized["price"], "0")
+                self.assertEqual(normalized["commission"], "0")
+
+    def test_nonempty_aliases_keep_existing_priority(self) -> None:
+        for value in ["123", "0", " "]:
+            with self.subTest(value=value):
+                source = {
+                    "program_id": 0,
+                    "id": value,
+                    "unit_price": 0,
+                    "price": value,
+                    "commission_amount": 0,
+                    "commission": value,
+                }
+                normalized = normalize_record("a8net", "products", source)
+                self.assertEqual(normalized["source_id"], value)
+                self.assertEqual(normalized["price"], value)
+                self.assertEqual(normalized["commission"], value)
+
+    def test_zero_id_is_included_in_fingerprint(self) -> None:
+        normalized = normalize_record("a8net", "products", {"id": 0})
+        expected = hashlib.sha256(b'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}').hexdigest()
+        self.assertEqual(normalized["fingerprint_sha256"], expected)
+
