+@pytest.mark.parametrize("scope", ["provider", "resource"])
+@pytest.mark.parametrize("next_url_path", [None, "paging.next.href"])
+def test_next_link_recorded_pages_are_normalized_and_persisted(
+    tmp_path, scope, next_url_path
+):
+    config = ready_config()
+    provider = config["providers"]["a8net"]
+    provider["auth"] = {"type": "bearer", "token": "synthetic"}
+    resource = provider["resources"]["products"]
+    resource.update(record_path="data.items", pagination={})
+    pagination = {"type": "next_link", "max_pages": 3}
+    if next_url_path is not None:
+        pagination["next_url_path"] = next_url_path
+    (provider if scope == "provider" else resource)["pagination"] = pagination
+    container = "paging" if next_url_path else "links"
+    first_record = {"id": "1", "reward_jpy": "¥1,200", "status": "pending"}
+    second_record = {"id": "2", "reward_jpy": 0}
+    first = {
+        "data": {"items": [first_record]},
+        container: {"next": {"href": "?page=2"}},
+    }
+    second = {
+        "data": {"items": [second_record]},
+        container: {"next": {"href": None}},
+    }
+    final_url = "https://example.invalid/v1/products"
+    with (
+        patch.object(
+            AffiliateHttpClient,
+            "request",
+            side_effect=[
+                response(first, final_url),
+                response(second, final_url + "?page=2"),
+            ],
+        ) as request,
+        patch.object(EndpointValidator, "validate") as validate,
+    ):
+        batch = fetch_resource(config, "a8net", "products")
+    assert [call.args[0] for call in request.call_args_list] == [
+        "https://example.invalid/products",
+        final_url + "?page=2",
+    ]
+    assert all(
+        call.kwargs["headers"]["Authorization"] == "Bearer synthetic"
+        for call in request.call_args_list
+    )
+    validate.assert_called_once_with(final_url + "?page=2")
+    assert batch.records == [first_record, second_record]
+    assert batch.warnings == []
+    manifest = persist_batch(batch, {"root": str(tmp_path)})
+    normalized = [
+        json.loads(line)
+        for line in (tmp_path / manifest["normalized_path"]).read_text().splitlines()
+    ]
+    assert manifest["page_count"] == 2
+    assert [record["commission"] for record in normalized] == ["1200", "0"]
+    assert [record["raw"] for record in normalized] == batch.records
+    assert normalized[0]["status"] == "pending"
+    assert normalized[0]["approved_at"] is None
+
