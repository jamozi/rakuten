             self.assertTrue(normalized_path.is_file())
 
 
+@pytest.mark.parametrize(
+    "zero,decimal_value",
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+@pytest.mark.parametrize("use_fallback", [False, True])
+def test_normalization_preserves_zero_and_alias_precedence(
+    zero, decimal_value, use_fallback
+):
+    # Lower-priority aliases appear first in the input to check alias ordering.
+    source = {
+        "item_id": "fallback-id",
+        "product_price": "1200",
+        "reward": "50",
+        "product_id": zero,
+        "unit_price": zero,
+        "commission_amount": zero,
+        "id": None if use_fallback else zero,
+        "price": "" if use_fallback else zero,
+        "commission": None if use_fallback else zero,
+    }
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == zero
+    assert type(normalized["source_id"]) is type(zero)
+    assert normalized["price"] == decimal_value
+    assert normalized["commission"] == decimal_value
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, (), set(), b""])
+def test_normalization_preserves_empty_value_handling(empty):
+    source = {"id": empty, "price": empty, "commission": empty}
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] is None
+    assert normalized["price"] is None
+    assert normalized["commission"] is None
+
+    source.update(product_id="P-1", unit_price="¥1,200", reward="50")
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == "P-1"
+    assert normalized["price"] == "1200"
+    assert normalized["commission"] == "50"
+
+
+def test_normalization_keeps_first_nonempty_alias():
+    source = {
+        "product_id": 0,
+        "unit_price": 0,
+        "reward": 0,
+        "id": "P-1",
+        "price": "¥1,200",
+        "commission": "50",
+    }
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == "P-1"
+    assert normalized["price"] == "1200"
+    assert normalized["commission"] == "50"
+
+
+def test_normalization_fingerprint_includes_zero_id():
+    normalized = normalize_record("a8net", "products", {"id": 0})
+    expected_seed = b'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}'
+    assert normalized["fingerprint_sha256"] == hashlib.sha256(expected_seed).hexdigest()
+
+
