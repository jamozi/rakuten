index 0000000..35950ed
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,34 @@
+"""Render update information from the existing public projection only."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped public update text, or raise ValueError for missing values.
+
+    Both article fields must be non-blank strings. Publication authorization
+    and projection validation remain the caller's existing boundary.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("public projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("public projection article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-blank string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-blank string")
+
+    return (
+        f"更新: {escape(updated_public_at, quote=True)}"
+        f" / 状態: {escape(freshness_status, quote=True)}"
+    )
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..acd96c7
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    # Synthetic value for this test only; the recorded candidate stays unchanged.
+    article["updated_public_at"] = "2026-09-06T00:00:00Z"
+    return projection
+
+
+@pytest.mark.parametrize("freshness_status", ["FRESH", "STALE", "UNKNOWN"])
+def test_renders_existing_public_fields_without_mutating_projection(
+    projection: dict[str, object], freshness_status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = freshness_status
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T00:00:00Z / 状態: {freshness_status}"
+    )
+    assert projection == original
+
+
+def test_escapes_html_metacharacters_in_both_fields(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "2026-09-06T00:00:00Z <&>\"'"
+    article["freshness_status"] = "<script>\"更新\" & '状態'</script>"
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z &lt;&amp;&gt;&quot;&#x27;"
+        " / 状態: &lt;script&gt;&quot;更新&quot; &amp; &#x27;状態&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_article_field_has_no_top_level_fallback(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    projection[field] = article.pop(field)
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 1, False, ["text"], {"text": 1}])
+def test_rejects_unavailable_or_non_string_article_values(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [
+        None,
+        [],
+        "text",
+        {},
+        {"article": None},
+        {"article": []},
+        {"article": "text"},
+        {"article": {}},
+    ],
+)
+def test_missing_or_malformed_article_raises_value_error(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_recorded_candidate_does_not_invent_an_update_date(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    original = deepcopy(projection)
+    article = cast(dict[str, object], projection["article"])
+    assert article["published_at"] is not None
+    assert article["updated_public_at"] is None
+
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
+
+    assert projection == original
