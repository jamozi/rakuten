+    def test_normalization_preserves_zero_values(self) -> None:
+        for aliases in (
+            ("id", "price", "commission"),
+            ("product_id", "unit_price", "commission_amount"),
+            ("order_id", "amount", "fee"),
+        ):
+            for value, amount in (
+                (0, "0"),
+                (0.0, "0.0"),
+                (Decimal("0.00"), "0.00"),
+                ("0", "0"),
+            ):
+                with self.subTest(aliases=aliases, value=value):
+                    source = dict.fromkeys(aliases, value)
+                    normalized = normalize_record("a8net", "products", source)
+                    self.assertEqual(normalized["source_id"], value)
+                    self.assertEqual(normalized["price"], amount)
+                    self.assertEqual(normalized["commission"], amount)
+                    self.assertEqual(normalized["raw"], source)
+
+    def test_normalization_preserves_alias_priority(self) -> None:
+        for preferred, fallback, amount in (
+            (0, 99, "0"),
+            (12, 0, "12"),
+            (12, 99, "12"),
+            (" \t", 99, " \t"),
+        ):
+            with self.subTest(preferred=preferred, fallback=fallback):
+                # Input order must not override the declared alias priority.
+                source = {
+                    "program_id": fallback,
+                    "unit_price": fallback,
+                    "commission_amount": fallback,
+                    "id": preferred,
+                    "price": preferred,
+                    "commission": preferred,
+                }
+                normalized = normalize_record("a8net", "products", source)
+                self.assertEqual(normalized["source_id"], preferred)
+                self.assertEqual(normalized["price"], amount)
+                self.assertEqual(normalized["commission"], amount)
+
+    def test_normalization_preserves_empty_value_handling(self) -> None:
+        for empty in (None, "", False, [], {}, (), set(), b""):
+            with self.subTest(empty=empty):
+                source = dict.fromkeys(("id", "price", "commission"), empty)
+                normalized = normalize_record("a8net", "products", source)
+                for field in ("source_id", "price", "commission"):
+                    self.assertIsNone(normalized[field])
+
+                source.update(
+                    program_id=0,
+                    product_id=99,
+                    unit_price=0,
+                    amount=99,
+                    reward=0,
+                    fee=99,
+                )
+                normalized = normalize_record("a8net", "products", source)
+                self.assertEqual(normalized["source_id"], 0)
+                self.assertEqual(normalized["price"], "0")
+                self.assertEqual(normalized["commission"], "0")
+
+    def test_normalization_keeps_absent_values_missing(self) -> None:
+        normalized = normalize_record("a8net", "products", {})
+        for field in ("source_id", "price", "commission"):
+            self.assertIsNone(normalized[field])
+
+    def test_zero_id_is_included_in_fingerprint(self) -> None:
+        normalized = normalize_record("a8net", "products", {"id": 0})
+        expected_seed = 'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}'
+        self.assertEqual(
+            normalized["fingerprint_sha256"],
+            hashlib.sha256(expected_seed.encode("utf-8")).hexdigest(),
+        )
+
