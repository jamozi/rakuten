index 0000000..e2e36e7
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,32 @@
+"""Render update information from the existing public projection."""
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text, raising ValueError for unavailable values.
+
+    The caller supplies the approved public projection. Rendering neither
+    resolves internal sources nor authorizes publication.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-empty string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-empty string")
+
+    return (
+        f"更新: {escape(updated_public_at, quote=True)} / "
+        f"状態: {escape(freshness_status, quote=True)}"
+    )
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..bf7fcae
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,87 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    result = step.result.projection()
+    article = cast(dict[str, object], result["article"])
+    # Synthetic update value on a fresh copy; the recorded artifact stays unchanged.
+    article["updated_public_at"] = "2026-09-06T09:30:00Z"
+    return result
+
+
+@pytest.mark.parametrize("status", ("FRESH", "STALE", "UNKNOWN", "UNAVAILABLE"))
+def test_renders_public_fields_without_mutating_projection(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T09:30:00Z / 状態: {status}"
+    )
+    assert projection == before
+
+
+def test_escapes_html_in_both_public_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "<time title=\"a&b\">'日時'</time>"
+    article["freshness_status"] = "<script>\"状態\"&'</script>"
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;a&amp;b&quot;&gt;&#x27;日時&#x27;&lt;/time&gt; / "
+        "状態: &lt;script&gt;&quot;状態&quot;&amp;&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ("updated_public_at", "freshness_status"))
+def test_missing_public_field_raises_value_error(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+
+    with pytest.raises(ValueError, match=field):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ("updated_public_at", "freshness_status"))
+@pytest.mark.parametrize("value", (None, "", " \t\n", 42, True, [], {}))
+def test_unavailable_or_non_text_field_raises_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=field):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "projection",
+    (None, [], "article", {}, {"article": None}, {"article": []}, {"article": ""}),
+)
+def test_missing_or_invalid_article_raises_value_error(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(projection)  # type: ignore[arg-type]
+
+
+def test_recorded_null_update_is_not_replaced_with_publication_time(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    assert article["updated_public_at"] is None
+    assert article["published_at"]
+
+    with pytest.raises(ValueError, match="updated_public_at"):
+        render_public_update_notice(projection)
