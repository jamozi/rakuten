+@pytest.mark.parametrize(
+    ("value", "expected_decimal"),
+    [
+        (0, "0"),
+        (0.0, "0.0"),
+        (Decimal("0.00"), "0.00"),
+        ("0", "0"),
+        (17, "17"),
+        (" ", " "),
+    ],
+)
+@pytest.mark.parametrize("with_fallback", [False, True])
+def test_normalization_preserves_values_and_alias_precedence(
+    value, expected_decimal, with_fallback
+):
+    source = {}
+    if with_fallback:
+        # Insert lower-priority aliases first to exercise alias ordering.
+        source.update(product_id="P-fallback", unit_price="99", reward="9")
+    source.update(id=value, price=value, commission=value)
+
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == value
+    assert type(normalized["source_id"]) is type(value)
+    assert normalized["price"] == expected_decimal
+    assert normalized["commission"] == expected_decimal
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}])
+@pytest.mark.parametrize(
+    ("fallback", "expected_decimal"), [(None, None), (0, "0"), (17, "17")]
+)
+def test_normalization_skips_empty_aliases(empty, fallback, expected_decimal):
+    normalized = normalize_record(
+        "a8net",
+        "products",
+        {
+            "id": empty,
+            "product_id": fallback,
+            "price": empty,
+            "unit_price": fallback,
+            "commission": empty,
+            "reward": fallback,
+        },
+    )
+
+    assert normalized["source_id"] == fallback
+    assert type(normalized["source_id"]) is type(fallback)
+    assert normalized["price"] == expected_decimal
+    assert normalized["commission"] == expected_decimal
+
+
