index 0000000..424ffb2
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,37 @@
+"""Render update information already present in a public projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+from typing import cast
+
+
+def _required_text(article: Mapping[str, object], field: str) -> str:
+    value = article.get(field)
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"article.{field} must be a non-empty string")
+    return value
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text; raise ValueError for unavailable values.
+
+    Consume only article.updated_public_at and article.freshness_status.
+    Missing values are never inferred from other fields or internal sources.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+    public_article = cast(Mapping[str, object], article)
+    updated_public_at = _required_text(public_article, "updated_public_at")
+    freshness_status = _required_text(public_article, "freshness_status")
+    return (
+        f"更新: {escape(updated_public_at, quote=True)} / "
+        f"状態: {escape(freshness_status, quote=True)}"
+    )
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..e07bef0
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,130 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from types import MappingProxyType
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    result = step.result.projection()
+    article = cast(dict[str, object], result["article"])
+    # Synthetic display input only; the recorded projector remains unchanged.
+    article["updated_public_at"] = "2026-09-06T09:00:00Z"
+    return result
+
+
+def test_notice_renders_existing_public_fields_without_mutating_projection(
+    projection: dict[str, object],
+) -> None:
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T09:00:00Z / 状態: UNKNOWN"
+    )
+    assert projection == original
+
+
+def test_notice_preserves_supplied_timestamp_and_status(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "2026-09-06T18:00:00+09:00"
+    article["freshness_status"] = "STALE"
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T18:00:00+09:00 / 状態: STALE"
+    )
+
+
+def test_notice_escapes_html_in_both_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time data-note="a&b">\'updated\'</time>'
+    article["freshness_status"] = '<script>"status" & \'unknown\'</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time data-note=&quot;a&amp;b&quot;&gt;&#x27;updated&#x27;&lt;/time&gt;"
+        " / 状態: &lt;script&gt;&quot;status&quot; &amp; &#x27;unknown&#x27;&lt;/script&gt;"
+    )
+
+
+def test_notice_accepts_read_only_projection(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    projection["article"] = MappingProxyType(article)
+
+    assert render_public_update_notice(MappingProxyType(projection)) == (
+        "更新: 2026-09-06T09:00:00Z / 状態: UNKNOWN"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_value_does_not_fall_back_to_unrelated_fields(
+    projection: dict[str, object],
+    field: str,
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+    projection[field] = "top-level-only"
+    for name in ("evidence", "finance"):
+        projection[name] = {field: "internal-only"}
+        article[name] = {field: "internal-only"}
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", False, 0, 1, [], {}])
+def test_notice_rejects_unavailable_or_non_text_values(
+    projection: dict[str, object],
+    field: str,
+    value: object,
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [None, [], "invalid", {}, {"article": None}, {"article": []}, {"article": ""}],
+)
+def test_notice_rejects_missing_or_invalid_containers(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_notice_does_not_render_unrelated_material(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    for name in ("evidence", "finance"):
+        projection[name] = {"updated_public_at": "internal-only"}
+        article[name] = {"freshness_status": "internal-only"}
+    article["title"] = "unrelated-title"
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T09:00:00Z / 状態: UNKNOWN"
+    )
+    assert projection == original
+
+
+def test_recorded_projection_without_public_update_time_fails(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    assert article["updated_public_at"] is None
+    assert article["published_at"] is not None
+
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
