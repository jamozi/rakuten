+    recorded = response(
+        {"items": [{"id": "1"}], "links": {"next": {"href": "?page=2"}}}
+    )
+    if limit == "bytes":
+        config["storage"]["max_uncompressed_bytes"] = len(recorded[2]) * 2 - 1
+    with (
+        patch.object(AffiliateHttpClient, "request", return_value=recorded) as request,
+        patch.object(EndpointValidator, "validate"),
+    ):
+        if limit == "bytes":
+            with pytest.raises(
+                FetchError, match="batch exceeds max_uncompressed_bytes"
+            ):
+                fetch_resource(config, "a8net", "products")
+        else:
+            batch = fetch_resource(config, "a8net", "products")
+            assert len(batch.pages) == 2
+            assert batch.warnings == ["Stopped at configured max_pages=2"]
+    assert request.call_count == 2
