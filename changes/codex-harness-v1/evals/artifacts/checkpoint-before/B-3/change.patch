+@pytest.mark.parametrize("limit", ["pages", "bytes"])
+def test_next_link_obeys_page_and_aggregate_limits(limit):
+    config = ready_config()
+    config["providers"]["a8net"]["resources"]["products"]["pagination"] = {
+        "type": "next_link",
+        "max_pages": 2,
