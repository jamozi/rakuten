+def test_next_link_recorded_pages_normalize_rewards(
+    tmp_path, next_url_path, href, expected_url
+):
+    config = ready_config()
+    provider = config["providers"]["a8net"]
+    provider["auth"] = {"type": "bearer", "token": "synthetic"}
+    provider["query"] = {"locale": "ja"}
+    resource = provider["resources"]["products"]
+    resource.update(
+        record_path="data.items", pagination={"type": "next_link", "max_pages": 3}
+    )
+    if next_url_path is not None:
+        resource["pagination"]["next_url_path"] = next_url_path
+    source = [
+        {"product_id": "1", "reward_jpy": "￥1,250"},
+        {"product_id": "2", "reward_jpy": 0},
+    ]
+    first = {
+        "data": {"items": [source[0]]},
+        "links": {"next": {"href": href}},
+        "paging": {"next_url": href},
+    }
+    second = {
+        "data": {"items": [source[1]]},
+        "links": {"next": {"href": None}},
+        "paging": {"next_url": None},
+    }
+    if next_url_path is not None:
+        first["links"]["next"]["href"] = "/unused"
+        second["links"]["next"]["href"] = "/unused"
+    path = tmp_path / "affiliate-networks.json"
+    atomic_write_config(path, config)
+    with (
+        patch.object(
+            AffiliateHttpClient,
+            "request",
+            side_effect=[
+                response(first, "https://example.invalid/catalog/products?locale=ja"),
+                response(second, expected_url + "&locale=ja"),
+            ],
+        ) as request,
+        patch.object(EndpointValidator, "validate") as validate,
+    ):
+        batch = fetch_resource(load_config(path), "a8net", "products")
+    assert batch.records == source
+    assert batch.warnings == []
+    assert [call.args[0] for call in request.call_args_list] == [
+        "https://example.invalid/products?locale=ja",
+        expected_url + "&locale=ja",
+    ]
+    for call in request.call_args_list:
+        assert call.kwargs == {
+            "method": "GET",
+            "headers": {"Authorization": "Bearer synthetic"},
+        }
+    validate.assert_called_once_with(expected_url)
+    manifest = persist_batch(batch, {"root": str(tmp_path)})
+    normalized = [
+        json.loads(line)
+        for line in (tmp_path / manifest["normalized_path"]).read_text().splitlines()
+    ]
+    assert [record["commission"] for record in normalized] == ["1250", "0"]
+    assert [record["raw"] for record in normalized] == source
+
