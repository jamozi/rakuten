             self.assertTrue(normalized_path.is_file())
 
 
+@pytest.mark.parametrize(
+    ("zero", "amount"),
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero_values(zero, amount):
+    source = {"id": zero, "price": zero, "commission": zero}
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == zero
+    assert type(normalized["source_id"]) is type(zero)
+    assert normalized["price"] == amount
+    assert normalized["commission"] == amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize(("preferred", "fallback"), [(0, 125), (125, 0)])
+def test_normalization_preserves_alias_priority_with_zero(preferred, fallback):
+    source = {
+        "program_id": fallback,
+        "unit_price": fallback,
+        "commission_amount": fallback,
+        " ID ": preferred,
+        "Price": preferred,
+        "COMMISSION": preferred,
+    }
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == preferred
+    assert normalized["price"] == str(preferred)
+    assert normalized["commission"] == str(preferred)
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, ()])
+def test_normalization_skips_empty_aliases_before_zero(empty):
+    normalized = normalize_record(
+        "a8net",
+        "products",
+        {
+            "id": empty,
+            "program_id": 0,
+            "product_id": "P-1",
+            "price": empty,
+            "unit_price": 0,
+            "amount": 125,
+            "commission": empty,
+            "commission_amount": 0,
+            "reward": 25,
+        },
+    )
+
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, ()])
+def test_normalization_keeps_empty_and_absent_values_missing(empty):
+    normalized = normalize_record(
+        "a8net", "products", {"id": empty, "price": empty, "commission": empty}
+    )
+
+    for field in ("source_id", "price", "commission", "name", "url"):
+        assert normalized[field] is None
+
+
+@pytest.mark.parametrize("source_id", [0, 7, None])
+def test_normalization_fingerprint_includes_source_id(source_id):
+    source = {"id": source_id}
+    normalized = normalize_record("a8net", "products", source)
+    expected_seed = "\x1f".join(
+        [
+            "a8net",
+            "products",
+            "" if source_id is None else str(source_id),
+            "",
+            json.dumps(source, ensure_ascii=False, sort_keys=True),
+        ]
+    )
+
+    assert normalized["fingerprint_sha256"] == hashlib.sha256(
+        expected_seed.encode("utf-8")
+    ).hexdigest()
+
+
