index 0000000..87f7aa6
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,28 @@
+"""Render update information from an existing public projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return HTML-safe notice text; reject missing or invalid required values."""
+
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-empty string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-empty string")
+
+    return f"更新: {escape(updated_public_at)} / 状態: {escape(freshness_status)}"
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..4c05521
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,90 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    document = step.result.projection()
+    article = cast(dict[str, object], document["article"])
+    article["updated_public_at"] = "2026-09-06T00:00:00Z"
+    return document
+
+
+def test_renders_existing_public_fields_without_mutating_projection(
+    projection: dict[str, object],
+) -> None:
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z / 状態: UNKNOWN"
+    )
+    assert projection == original
+
+
+def test_escapes_html_in_both_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time title="更新">&\'</time>'
+    article["freshness_status"] = '<script title="状態">&\'</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;更新&quot;&gt;&amp;&#x27;&lt;/time&gt;"
+        " / 状態: &lt;script title=&quot;状態&quot;&gt;&amp;&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_required_field_raises_value_error(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, [], {}])
+def test_empty_or_non_text_required_field_raises_value_error(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [None, [], {}, {"article": None}, {"article": []}, {"article": "invalid"}],
+)
+def test_missing_or_invalid_article_raises_value_error(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_recorded_projection_without_update_date_does_not_fall_back(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+def test_unrelated_fields_are_not_rendered(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    for field in ("evidence", "finance", "raw_ai"):
+        projection[field] = "synthetic-private-material"
+        article[field] = "synthetic-private-material"
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z / 状態: UNKNOWN"
+    )
