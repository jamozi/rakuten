@@ -0,0 +1,32 @@
+"""Render update metadata from an existing public projection without I/O."""
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text; missing or invalid public values raise ValueError.
+
+    The caller supplies the approved public projection. This renderer neither
+    approves publication nor derives missing values from other data sources.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-empty string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-empty string")
+
+    return (
+        f"更新: {escape(updated_public_at, quote=True)}"
+        f" / 状態: {escape(freshness_status, quote=True)}"
+    )
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..03373f4
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    value = step.result.projection()
+    article = cast(dict[str, object], value["article"])
+    article["updated_public_at"] = "2026-09-06T12:34:56+09:00"
+    return value
+
+
+@pytest.mark.parametrize("status", ["UNKNOWN", "FRESH", "STALE"])
+def test_notice_uses_public_article_values_without_mutating_projection(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T12:34:56+09:00 / 状態: {status}"
+    )
+    assert projection == before
+
+
+def test_notice_escapes_html_in_both_public_values(
+    projection: dict[str, object],
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = "<time title=\"now\">&'</time>"
+    article["freshness_status"] = "<script>\"&'</script>"
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;now&quot;&gt;&amp;&#x27;&lt;/time&gt;"
+        " / 状態: &lt;script&gt;&quot;&amp;&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize(
+    "value",
+    [None, [], "invalid", {}, {"article": None}, {"article": []}, {"article": "invalid"}],
+)
+def test_notice_rejects_missing_or_malformed_projection(value: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], value))
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_missing_public_field_never_falls_back_to_other_data(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    value = article.pop(field)
+    projection[field] = value
+    projection["evidence"] = {field: value}
+    projection["finance"] = {field: value}
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n ", 123, False, [], {}])
+def test_notice_rejects_empty_or_non_string_public_values(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+def test_recorded_unknown_update_time_is_not_replaced_by_publication_time(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+def test_notice_does_not_render_unrelated_internal_material(
+    projection: dict[str, object],
+) -> None:
+    expected = render_public_update_notice(projection)
+    projection["evidence"] = {"source": "synthetic-internal-evidence"}
+    projection["finance"] = {"amount": "synthetic-internal-finance"}
+    article = cast(dict[str, object], projection["article"])
+    article["raw_ai"] = "synthetic-internal-ai"
+
+    assert render_public_update_notice(projection) == expected
