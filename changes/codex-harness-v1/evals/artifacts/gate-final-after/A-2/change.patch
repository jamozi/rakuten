+@pytest.mark.parametrize(
+    "value,amount",
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero_and_alias_priority(value, amount):
+    source = {
+        "product_id": "fallback",
+        "amount": 100,
+        "reward": 10,
+        "id": value,
+        "price": value,
+        "commission": value,
+    }
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == value
+    assert type(normalized["source_id"]) is type(value)
+    assert normalized["price"] == amount
+    assert normalized["commission"] == amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}])
+def test_normalization_skips_empty_aliases(empty):
+    source = {"id": empty, "price": empty, "commission": empty}
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] is None
+    assert normalized["price"] is None
+    assert normalized["commission"] is None
+
+    source.update(
+        {
+            "product_id": 0,
+            "item_id": "fallback",
+            "product_price": 0,
+            "amount": 100,
+            "payout": 0,
+            "fee": 10,
+        }
+    )
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+@pytest.mark.parametrize("value,amount", [(12, "12"), (" \t ", " \t ")])
+def test_normalization_preserves_existing_alias_priority(value, amount):
+    normalized = normalize_record(
+        "a8net",
+        "products",
+        {
+            "product_id": 0,
+            "amount": 0,
+            "reward": 0,
+            "id": value,
+            "price": value,
+            "commission": value,
+        },
+    )
+    assert normalized["source_id"] == value
+    assert normalized["price"] == amount
+    assert normalized["commission"] == amount
+
+
+@pytest.mark.parametrize(
+    "source,seed",
+    [
+        ({"id": 0}, b'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}'),
+        ({"id": "P-1"}, b'a8net\x1fproducts\x1fP-1\x1f\x1f{"id": "P-1"}'),
+        ({"id": None}, b'a8net\x1fproducts\x1f\x1f\x1f{"id": null}'),
+        ({}, b"a8net\x1fproducts\x1f\x1f\x1f{}"),
+    ],
+)
+def test_normalization_fingerprint_uses_source_id(source, seed):
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["fingerprint_sha256"] == hashlib.sha256(seed).hexdigest()
+
