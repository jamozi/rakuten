+@pytest.mark.parametrize(
+    ("field", "primary", "fallback"),
+    [
+        ("source_id", "id", "product_id"),
+        ("price", "price", "unit_price"),
+        ("commission", "commission", "reward"),
+    ],
+)
+@pytest.mark.parametrize("zero", [0, 0.0, Decimal("0.00"), "0"])
+@pytest.mark.parametrize("position", ["only", "primary", "fallback"])
+def test_normalization_preserves_zero_and_alias_priority(
+    field, primary, fallback, zero, position
+):
+    if position == "fallback":
+        source = {primary: "", fallback: zero}
+    elif position == "primary":
+        # Input order must not override the configured alias priority.
+        source = {fallback: 12, primary: zero}
+    else:
+        source = {primary: zero}
+
+    normalized = normalize_record("a8net", "products", source)
+
+    expected = zero if field == "source_id" else str(zero)
+    assert normalized[field] == expected
+    assert type(normalized[field]) is type(expected)
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, ()])
+@pytest.mark.parametrize("has_fallback", [False, True])
+def test_normalization_preserves_empty_value_handling(empty, has_fallback):
+    source = {"id": empty, "price": empty, "commission": empty}
+    if has_fallback:
+        source.update(product_id="P-1", unit_price="1200", reward="120")
+
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == ("P-1" if has_fallback else None)
+    assert normalized["price"] == ("1200" if has_fallback else None)
+    assert normalized["commission"] == ("120" if has_fallback else None)
+
+
