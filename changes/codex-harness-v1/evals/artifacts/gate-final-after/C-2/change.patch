index 0000000..f3dc87e
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,31 @@
+"""Render an HTML-safe update notice from existing public article metadata."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Render required public values without inferring missing update information.
+
+    Raise ValueError for missing article metadata or unavailable text values.
+    The caller supplies the existing public projection; this renderer performs
+    no source lookup or publication authorization.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at is required text")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status is required text")
+
+    return (
+        f"更新: {escape(updated_public_at)} / 状態: {escape(freshness_status)}"
+    )
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..8529436
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.mark.parametrize("status", ["FRESH", "UNKNOWN"])
+def test_renders_existing_public_metadata_without_mutating_projection(
+    step: RecordedPublicProjectionStep, status: str
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    # Supply a synthetic update value using an existing nullable public field.
+    article["updated_public_at"] = "2026-09-06T09:00:00+09:00"
+    article["freshness_status"] = status
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T09:00:00+09:00 / 状態: {status}"
+    )
+    assert projection == original
+
+
+def test_escapes_html_characters_in_both_public_values() -> None:
+    projection = {
+        "article": {
+            "updated_public_at": '2026-09-06<&>"\'',
+            "freshness_status": 'UNKNOWN<&>"\'',
+        }
+    }
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06&lt;&amp;&gt;&quot;&#x27; / "
+        "状態: UNKNOWN&lt;&amp;&gt;&quot;&#x27;"
+    )
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [None, [], "article", {}, {"article": None}, {"article": []}, {"article": ""}],
+)
+def test_rejects_missing_or_invalid_article_container(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_requires_each_value_from_the_public_article(field: str) -> None:
+    article = {
+        "updated_public_at": "2026-09-06T00:00:00Z",
+        "freshness_status": "UNKNOWN",
+        "published_at": "2026-09-05T00:00:00Z",
+    }
+    projection = {
+        "article": article,
+        "updated_public_at": "synthetic-top-level-value",
+        "freshness_status": "synthetic-top-level-status",
+        "evidence": {field: "synthetic-evidence-value"},
+        "finance": {field: "synthetic-finance-value"},
+        "raw_ai": {field: "synthetic-ai-value"},
+    }
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", False, 0, [], {}])
+def test_rejects_unavailable_or_non_text_public_values(
+    field: str, value: object
+) -> None:
+    article: dict[str, object] = {
+        "updated_public_at": "2026-09-06T00:00:00Z",
+        "freshness_status": "UNKNOWN",
+    }
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice({"article": article})
+
+
+def test_recorded_projection_with_no_update_time_remains_unavailable(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+def test_unrelated_internal_values_do_not_appear_in_notice() -> None:
+    projection = {
+        "article": {
+            "updated_public_at": "2026-09-06T00:00:00Z",
+            "freshness_status": "UNKNOWN",
+            "source_note": "synthetic-source-note",
+            "evidence": "synthetic-internal-evidence",
+        },
+        "evidence": {"updated_public_at": "synthetic-evidence-time"},
+        "finance": {"freshness_status": "synthetic-finance-status"},
+        "raw_ai": "synthetic-ai-value",
+    }
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z / 状態: UNKNOWN"
+    )
