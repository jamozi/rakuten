+    def test_numeric_zero_is_preserved(self) -> None:
+        for zero in (0, 0.0, Decimal("0.00"), "0"):
+            with self.subTest(zero=zero):
+                source = {"id": zero, "price": zero, "commission": zero}
+                normalized = normalize_record("a8net", "products", source)
+                self.assertEqual(normalized["source_id"], zero)
+                self.assertIs(type(normalized["source_id"]), type(zero))
+                self.assertEqual(normalized["price"], str(zero))
+                self.assertEqual(normalized["commission"], str(zero))
+                self.assertEqual(normalized["raw"], source)
+
+    def test_alias_priority_includes_numeric_zero(self) -> None:
+        for first, later in ((0, 99), (99, 0)):
+            with self.subTest(first=first):
+                normalized = normalize_record(
+                    "a8net",
+                    "products",
+                    {
+                        "product_id": later,
+                        "unit_price": later,
+                        "reward": later,
+                        "id": first,
+                        "price": first,
+                        "commission": first,
+                    },
+                )
+                self.assertEqual(normalized["source_id"], first)
+                self.assertEqual(normalized["price"], str(first))
+                self.assertEqual(normalized["commission"], str(first))
+
+    def test_empty_aliases_still_fall_back(self) -> None:
+        for empty in (None, "", False, [], {}, ()):
+            with self.subTest(empty=empty):
+                source = {"id": empty, "price": empty, "commission": empty}
+                missing = normalize_record("a8net", "products", source)
+                for field in ("source_id", "price", "commission"):
+                    self.assertIsNone(missing[field])
+                for fallback in (0, 99):
+                    with self.subTest(fallback=fallback):
+                        normalized = normalize_record(
+                            "a8net",
+                            "products",
+                            {
+                                **source,
+                                "product_id": fallback,
+                                "unit_price": fallback,
+                                "reward": fallback,
+                            },
+                        )
+                        self.assertEqual(normalized["source_id"], fallback)
+                        self.assertEqual(normalized["price"], str(fallback))
+                        self.assertEqual(normalized["commission"], str(fallback))
+
+    def test_fingerprint_includes_zero_source_id(self) -> None:
+        source = {"id": 0}
+        expected_seed = 'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}'
+        normalized = normalize_record("a8net", "products", source)
+        self.assertEqual(
+            normalized["fingerprint_sha256"],
+            hashlib.sha256(expected_seed.encode("utf-8")).hexdigest(),
+        )
+
