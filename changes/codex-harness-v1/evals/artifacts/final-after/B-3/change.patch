+    )
+    if limit == "max_uncompressed_bytes":
+        config["storage"][limit] = len(recorded[2]) * 2 - 1
+    with (
+        patch.object(AffiliateHttpClient, "request", return_value=recorded) as request,
+        patch.object(EndpointValidator, "validate"),
+    ):
+        if limit == "max_uncompressed_bytes":
+            with pytest.raises(
