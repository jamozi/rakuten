+def test_next_link_fetches_and_normalizes_recorded_pages(
+    tmp_path, path, href, expected_url
+):
+    config = ready_config()
+    provider = config["providers"]["a8net"]
+    provider["pagination"] = {"next_url_path": path} if path else {}
+    resource = provider["resources"]["products"]
+    resource["pagination"] = {"type": "next_link", "max_pages": 3}
+    config_path = tmp_path / "config.json"
+    atomic_write_config(config_path, config)
+    config = load_config(config_path)
+    first_record = {"id": "1", "reward_jpy": "￥1,234.50", "status": "pending"}
+    second_record = {"id": "2", "reward_jpy": 0}
+    container = "paging" if path else "links"
+    first = {
+        "items": [first_record],
+        "links": {"next": {"href": "https://other.invalid/unused"}},
+        container: {"next": {"href": href}},
+    }
+    second = {"items": [second_record], container: {"next": {"href": None}}}
+    with (
+        patch.object(
+            AffiliateHttpClient,
+            "request",
+            side_effect=[
+                response(first, "https://example.invalid/api/products?page=1"),
+                response(second, expected_url),
+            ],
+        ) as request,
+        patch.object(EndpointValidator, "validate") as validate,
+    ):
+        batch = fetch_resource(config, "a8net", "products")
+    assert [call.args[0] for call in request.call_args_list] == [
+        "https://example.invalid/products",
