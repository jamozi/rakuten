@@ -0,0 +1,32 @@
+"""Render update information already present in a public projection."""
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped text; raise ValueError for missing or invalid notice fields.
+
+    The caller supplies the approved snapshot's public projection. This renderer
+    neither validates publication authority nor fills unavailable public values.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("public projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("public projection must contain an article mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-blank string")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-blank string")
+
+    return (
+        f"更新: {escape(updated_public_at, quote=True)}"
+        f" / 状態: {escape(freshness_status, quote=True)}"
+    )
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..2510425
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    result = step.result.projection()
+    article = cast(dict[str, object], result["article"])
+    # Synthetic display input: the recorded candidate has no public update yet.
+    article["updated_public_at"] = "2026-09-06T09:00:00Z"
+    return result
+
+
+@pytest.mark.parametrize("status", ["UNKNOWN", "STALE"])
+def test_notice_uses_existing_projection_without_mutation(
+    projection: dict[str, object], status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = status
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T09:00:00Z / 状態: {status}"
+    )
+    assert projection == original
+
+
+def test_recorded_projection_without_public_update_is_unavailable(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+def test_notice_escapes_html_in_both_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time data-value="x&y">\'date\'</time>'
+    article["freshness_status"] = '<script>"x&y";\'status\'</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time data-value=&quot;x&amp;y&quot;&gt;"
+        "&#x27;date&#x27;&lt;/time&gt;"
+        " / 状態: &lt;script&gt;&quot;x&amp;y&quot;;"
+        "&#x27;status&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [None, [], "article", {}, {"article": None}, {"article": []}, {"article": {}}],
+)
+def test_notice_requires_an_article_mapping(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(projection)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_notice_rejects_missing_required_fields(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, [], {}])
+def test_notice_rejects_unavailable_or_non_string_values(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_notice_never_fills_missing_values_from_unrelated_or_internal_data(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    decoy = {
+        "updated_public_at": "2026-09-06T10:00:00Z",
+        "freshness_status": "FRESH",
+    }
+    projection.update(decoy)
+    projection["evidence"] = decoy
+    projection["finance"] = decoy
+    article["evidence"] = decoy
+    article["finance"] = decoy
+    del article[field]
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
