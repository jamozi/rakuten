@@ -153,6 +154,54 @@ class NormalizationAndStorageTests(unittest.TestCase):
             self.assertTrue(normalized_path.is_file())
 
 
+@pytest.mark.parametrize(
+    ("zero", "expected_amount"),
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+def test_normalization_preserves_zero_values(zero, expected_amount):
+    source = {"id": zero, "price": zero, "commission": zero}
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == zero
+    assert type(normalized["source_id"]) is type(zero)
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}, (), set()])
+def test_normalization_skips_empty_values_and_falls_back_to_zero(empty):
+    source = {"id": empty, "price": empty, "commission": empty}
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] is None
+    assert normalized["price"] is None
+    assert normalized["commission"] is None
+
+    source.update(product_id=0, unit_price=0, reward=0)
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+@pytest.mark.parametrize(("preferred", "fallback"), [(0, 42), (42, 0)])
+def test_normalization_preserves_alias_priority_with_zero(preferred, fallback):
+    # Put later aliases first to check that field order does not set priority.
+    source = {
+        "product_id": fallback,
+        "unit_price": fallback,
+        "reward": fallback,
+        "id": preferred,
+        "price": preferred,
+        "commission": preferred,
+    }
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == preferred
+    assert normalized["price"] == str(preferred)
+    assert normalized["commission"] == str(preferred)
+
+
