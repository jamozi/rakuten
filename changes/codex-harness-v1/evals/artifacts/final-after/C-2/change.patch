new file mode 100644
index 0000000..1b76aed
--- /dev/null
+++ b/python/raos/application/publishing/public_update_notice.py
@@ -0,0 +1,30 @@
+"""Render update metadata from an already validated public projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text; missing or invalid metadata raises ValueError."""
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a non-empty string")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a non-empty string")
+
+    return (
+        f"更新: {escape(updated_public_at, quote=True)} / "
+        f"状態: {escape(freshness_status, quote=True)}"
+    )
+
+
+__all__ = ("render_public_update_notice",)
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..c5f8e92
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from types import MappingProxyType
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    """Populate the existing optional timestamp on a detached synthetic projection."""
+    value = step.result.projection()
+    article = cast(dict[str, object], value["article"])
+    article["updated_public_at"] = "2026-09-06T09:30:00Z"
+    return value
+
+
+def test_notice_renders_existing_public_fields_without_mutation(
+    projection: dict[str, object],
+) -> None:
+    before = deepcopy(projection)
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T09:30:00Z / 状態: UNKNOWN"
+    )
+    assert projection == before
+
+
+def test_notice_accepts_read_only_projection(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = "確認中"
+    projection["article"] = MappingProxyType(article)
+    assert render_public_update_notice(MappingProxyType(projection)) == (
+        "更新: 2026-09-06T09:30:00Z / 状態: 確認中"
+    )
+
+
+@pytest.mark.parametrize("field_name", ["updated_public_at", "freshness_status"])
+def test_notice_escapes_html_in_each_value(
+    projection: dict[str, object], field_name: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field_name] = "<script>\"&'</script>"
+    escaped = "&lt;script&gt;&quot;&amp;&#x27;&lt;/script&gt;"
+    expected = (
+        f"更新: {escaped} / 状態: UNKNOWN"
+        if field_name == "updated_public_at"
+        else f"更新: 2026-09-06T09:30:00Z / 状態: {escaped}"
+    )
+    assert render_public_update_notice(projection) == expected
+
+
+@pytest.mark.parametrize("field_name", ["updated_public_at", "freshness_status"])
+def test_notice_rejects_missing_values_without_internal_or_top_level_fallback(
+    projection: dict[str, object], field_name: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    fallback = article.pop(field_name)
+    # Deliberately malformed input: these are not additions to the public contract.
+    projection[field_name] = fallback
+    projection["evidence"] = {field_name: fallback}
+    projection["finance"] = {field_name: fallback}
+    with pytest.raises(ValueError, match=rf"article\.{field_name}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field_name", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", False, 42, [], {}])
+def test_notice_rejects_empty_or_non_text_values(
+    projection: dict[str, object], field_name: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field_name] = value
+    with pytest.raises(ValueError, match=rf"article\.{field_name}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("article", [None, [], "article", 42])
+def test_notice_rejects_non_mapping_article(article: object) -> None:
+    with pytest.raises(ValueError, match=r"projection\.article"):
+        render_public_update_notice({"article": article})
+
+
+def test_notice_rejects_missing_article() -> None:
+    with pytest.raises(ValueError, match=r"projection\.article"):
+        render_public_update_notice({})
+
+
+@pytest.mark.parametrize("projection", [None, [], "projection"])
+def test_notice_rejects_non_mapping_projection(projection: object) -> None:
+    with pytest.raises(ValueError, match="projection must be a mapping"):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_recorded_null_timestamp_is_not_replaced_by_published_at(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    assert article["updated_public_at"] is None
+    assert article["published_at"]
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
