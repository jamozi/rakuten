+@pytest.mark.parametrize(
+    "value,expected_amount",
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+@pytest.mark.parametrize("with_fallbacks", [False, True])
+def test_normalization_preserves_zero_values(value, expected_amount, with_fallbacks):
+    source = (
+        {"product_id": "P-1", "unit_price": 1200, "reward": 100}
+        if with_fallbacks
+        else {}
+    )
+    source.update(id=value, price=value, commission=value)
+
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == value
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize(
+    "empty",
+    [None, "", False, [], {}],
+    ids=["null", "empty-string", "false", "empty-list", "empty-object"],
+)
+def test_normalization_keeps_empty_alias_handling(empty):
+    source = {"id": empty, "price": empty, "commission": empty}
+    normalized = normalize_record("a8net", "products", source)
+    for field in ("source_id", "price", "commission", "name"):
+        assert normalized[field] is None
+
+    source.update(
+        product_id=0,
+        code="P-1",
+        unit_price=0,
+        amount=1200,
+        reward=0,
+        fee=100,
+    )
+    normalized = normalize_record("a8net", "products", source)
+    assert normalized["source_id"] == 0
+    assert normalized["price"] == "0"
+    assert normalized["commission"] == "0"
+
+
+@pytest.mark.parametrize("value,expected_amount", [(7, "7"), (" \t", " \t")])
+def test_normalization_keeps_first_alias_precedence(value, expected_amount):
+    source = {
+        "product_id": 0,
+        "unit_price": 0,
+        "reward": 0,
+        "ID": value,
+        " Price ": value,
+        "Commission": value,
+    }
+
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == value
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+
+
+@pytest.mark.parametrize(
+    "source,expected_seed",
+    [
+        ({"id": 0}, b'a8net\x1fproducts\x1f0\x1f\x1f{"id": 0}'),
+        ({"id": "P-1"}, b'a8net\x1fproducts\x1fP-1\x1f\x1f{"id": "P-1"}'),
+        ({"id": None}, b'a8net\x1fproducts\x1f\x1f\x1f{"id": null}'),
+    ],
+)
+def test_normalization_fingerprint_includes_source_id(source, expected_seed):
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["fingerprint_sha256"] == hashlib.sha256(expected_seed).hexdigest()
+
