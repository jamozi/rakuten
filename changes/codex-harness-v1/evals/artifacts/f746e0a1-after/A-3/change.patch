+@pytest.mark.parametrize(
+    ("zero", "amount"),
+    [(0, "0"), (0.0, "0.0"), (Decimal("0.00"), "0.00"), ("0", "0")],
+)
+@pytest.mark.parametrize(
+    "fallbacks",
+    [{}, {"program_id": "P-1", "unit_price": 1200, "commission_amount": 50}],
+)
+def test_normalization_preserves_zero_values(zero, amount, fallbacks):
+    source = {**fallbacks, "id": zero, "price": zero, "commission": zero}
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == zero
+    assert normalized["price"] == amount
+    assert normalized["commission"] == amount
+    assert normalized["raw"] == source
+
+
+@pytest.mark.parametrize("empty", [None, "", False, [], {}])
+@pytest.mark.parametrize("fallback", [None, 0, 1200])
+def test_normalization_skips_empty_aliases(empty, fallback):
+    source = {"id": empty, "price": empty, "commission": empty}
+    if fallback is not None:
+        source.update(
+            program_id=fallback, unit_price=fallback, commission_amount=fallback
+        )
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == fallback
+    amount = None if fallback is None else str(fallback)
+    assert normalized["price"] == amount
+    assert normalized["commission"] == amount
+
+
+def test_normalization_uses_alias_priority_instead_of_record_order():
+    source = {
+        "product_id": "lower-priority-id",
+        "program_id": "preferred-id",
+        "product_price": 1200,
+        "unit_price": 1000,
+        "reward": 50,
+        "commission_amount": 40,
+    }
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == "preferred-id"
+    assert normalized["price"] == "1000"
+    assert normalized["commission"] == "40"
+
+
