+@pytest.mark.parametrize("next_url_path", [None, "paging.follow.href"])
+def test_next_link_fetches_and_normalizes_recorded_pages(tmp_path, next_url_path):
+    config = ready_config()
+    provider = config["providers"]["a8net"]
+    pagination = {"type": "next_link", "max_pages": 3}
+    resource = provider["resources"]["products"]
+    if next_url_path is None:
+        resource["pagination"] = pagination
+    else:
+        provider["pagination"] = pagination
+        resource["pagination"] = {"next_url_path": next_url_path}
+    resource["query"] = {"site": "synthetic"}
+    first_record = {"id": "1", "reward_jpy": "¥1,200.50", "status": "pending"}
+    second_record = {"id": "2", "reward_jpy": 0}
+    relative_url = "second.json?page=2"
+    first = {
+        "items": [first_record],
+        "links": {
+            "next": {
+                "href": relative_url
+                if next_url_path is None
+                else "https://other.invalid/unused"
+            }
+        },
+        "paging": {"follow": {"href": relative_url}},
+    }
+    second = {
+        "items": [second_record],
+        "links": {"next": {"href": None}},
+        "paging": {"follow": {"href": None}},
+    }
+    final_url = "https://example.invalid/exports/pages/first.json"
+    next_url = "https://example.invalid/exports/pages/second.json?page=2"
+    with (
+        patch.object(
+            AffiliateHttpClient,
+            "request",
+            side_effect=[response(first, final_url), response(second, next_url)],
+        ) as request,
+        patch.object(EndpointValidator, "validate") as validate,
+    ):
+        batch = fetch_resource(config, "a8net", "products")
+    assert [call.args[0] for call in request.call_args_list] == [
+        "https://example.invalid/products?site=synthetic",
+        next_url + "&site=synthetic",
+    ]
+    validate.assert_called_once_with(next_url)
+    assert batch.records == [first_record, second_record]
+    assert batch.warnings == []
+    manifest = persist_batch(batch, {"root": str(tmp_path)})
+    assert manifest["page_count"] == 2
+    normalized = [
+        json.loads(line)
+        for line in (tmp_path / manifest["normalized_path"]).read_text().splitlines()
+    ]
+    assert [record["commission"] for record in normalized] == ["1200.50", "0"]
+    assert [record["raw"] for record in normalized] == [first_record, second_record]
+    assert [record["status"] for record in normalized] == ["pending", None]
+    assert all(record["approved_at"] is None for record in normalized)
+
+
