@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+@pytest.fixture
+def projection(step: RecordedPublicProjectionStep) -> dict[str, object]:
+    result = step.result.projection()
+    article = cast(dict[str, object], result["article"])
+    # Synthetic display input; the recorded projector intentionally has no update time.
+    article["updated_public_at"] = "2026-09-06T09:00:00+09:00"
+    return result
+
+
+@pytest.mark.parametrize("freshness_status", ["UNKNOWN", "FRESH", "STALE"])
+def test_notice_uses_public_values_without_mutating_projection(
+    projection: dict[str, object], freshness_status: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["freshness_status"] = freshness_status
+    original = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        f"更新: 2026-09-06T09:00:00+09:00 / 状態: {freshness_status}"
+    )
+    assert projection == original
+
+
+def test_notice_escapes_html_in_both_values(projection: dict[str, object]) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article["updated_public_at"] = '<time title="更新">\'日時\' &</time>'
+    article["freshness_status"] = '<script>alert("状態" & \'x\')</script>'
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;更新&quot;&gt;&#x27;日時&#x27; &amp;&lt;/time&gt;"
+        " / 状態: &lt;script&gt;alert(&quot;状態&quot; &amp; &#x27;x&#x27;)&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_notice_rejects_missing_values_without_fallback(
+    projection: dict[str, object], field: str
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    del article[field]
+    # Decoys are synthetic and must not supply a missing public article value.
+    projection[field] = "root-level-decoy"
+    projection["evidence"] = {field: "synthetic-evidence-decoy"}
+    projection["finance"] = {field: "synthetic-finance-decoy"}
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, [], {}])
+def test_notice_rejects_unavailable_or_non_string_values(
+    projection: dict[str, object], field: str, value: object
+) -> None:
+    article = cast(dict[str, object], projection["article"])
+    article[field] = value
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [None, [], "invalid", {}, {"article": None}, {"article": []}, {"article": "invalid"}],
+)
+def test_notice_rejects_missing_or_invalid_article_structure(projection: object) -> None:
+    with pytest.raises(ValueError):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_notice_rejects_recorded_projection_without_update_time(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(step.result.projection())
+
+
+def test_notice_ignores_unrelated_fields(projection: dict[str, object]) -> None:
+    expected = render_public_update_notice(projection)
+    projection["evidence"] = {"updated_public_at": "synthetic-evidence-decoy"}
+    projection["finance"] = {"freshness_status": "synthetic-finance-decoy"}
+    article = cast(dict[str, object], projection["article"])
+    article["title"] = "synthetic-unrelated-title"
+
+    assert render_public_update_notice(projection) == expected
