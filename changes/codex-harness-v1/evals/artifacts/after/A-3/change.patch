+@pytest.mark.parametrize("empty", [None, "", False, [], {}])
+@pytest.mark.parametrize(
+    ("fallback", "expected_amount"), [(None, None), (0, "0"), ("12", "12")]
+)
+def test_normalization_preserves_empty_alias_fallback(empty, fallback, expected_amount):
+    source = {
+        "id": empty,
+        "program_id": fallback,
+        "price": empty,
+        "unit_price": fallback,
+        "commission": empty,
+        "reward": fallback,
+    }
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == fallback
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
+
+
+@pytest.mark.parametrize(
