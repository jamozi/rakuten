+    [{}, {"program_id": "P-2", "unit_price": "1200", "reward": "50"}],
+)
+def test_normalization_preserves_zero_and_alias_precedence(
+    zero, expected_amount, later_aliases
+):
+    source = {**later_aliases, "id": zero, "price": zero, "commission": zero}
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == zero
+    assert normalized["price"] == expected_amount
+    assert normalized["commission"] == expected_amount
