+    source = {
+        "program_id": 0,
+        "unit_price": 0,
+        "reward": 0,
+        "id": first,
+        "price": first,
+        "commission": first,
+    }
+    normalized = normalize_record("a8net", "products", source)
+
+    assert normalized["source_id"] == first
+    assert normalized["price"] == expected_amount
