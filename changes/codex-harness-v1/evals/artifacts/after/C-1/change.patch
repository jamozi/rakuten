@@ -0,0 +1,28 @@
+"""Render update information from the existing public projection."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from html import escape
+
+
+def render_public_update_notice(projection: Mapping[str, object]) -> str:
+    """Return escaped notice text; require both public fields to be nonblank strings.
+
+    The caller supplies the approved public projection. Missing information is
+    never inferred from other timestamps or internal data.
+    """
+    if not isinstance(projection, Mapping):
+        raise ValueError("projection must be a mapping")
+    article = projection.get("article")
+    if not isinstance(article, Mapping):
+        raise ValueError("projection.article must be a mapping")
+
+    updated_public_at = article.get("updated_public_at")
+    freshness_status = article.get("freshness_status")
+    if not isinstance(updated_public_at, str) or not updated_public_at.strip():
+        raise ValueError("article.updated_public_at must be a nonblank string")
+    if not isinstance(freshness_status, str) or not freshness_status.strip():
+        raise ValueError("article.freshness_status must be a nonblank string")
+
+    return f"更新: {escape(updated_public_at)} / 状態: {escape(freshness_status)}"
diff --git a/tests/st0904_v2/test_public_update_notice.py b/tests/st0904_v2/test_public_update_notice.py
new file mode 100644
index 0000000..df85f62
--- /dev/null
+++ b/tests/st0904_v2/test_public_update_notice.py
@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+from collections.abc import Mapping
+from copy import deepcopy
+from types import MappingProxyType
+from typing import cast
+
+import pytest
+
+from raos.adapters.recorded_public_projection_v2 import RecordedPublicProjectionStep
+from raos.application.publishing.public_update_notice import render_public_update_notice
+
+
+def test_render_uses_existing_public_projection_without_mutating_it(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    # A synthetic timestamp exercises the existing nullable public field.
+    article["updated_public_at"] = "2026-09-06T09:00:00+09:00"
+    before = deepcopy(projection)
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T09:00:00+09:00 / 状態: UNKNOWN"
+    )
+    assert projection == before
+
+
+def test_render_accepts_read_only_public_fields() -> None:
+    projection = MappingProxyType(
+        {
+            "article": MappingProxyType(
+                {
+                    "updated_public_at": "2026-09-06T00:00:00Z",
+                    "freshness_status": "FRESH",
+                }
+            )
+        }
+    )
+
+    assert render_public_update_notice(projection) == (
+        "更新: 2026-09-06T00:00:00Z / 状態: FRESH"
+    )
+
+
+def test_render_escapes_html_in_both_public_fields() -> None:
+    projection = {
+        "article": {
+            "updated_public_at": '<time title="a&b">\'更新\'</time>',
+            "freshness_status": '<script>"a" & \'b\'</script>',
+        }
+    }
+
+    assert render_public_update_notice(projection) == (
+        "更新: &lt;time title=&quot;a&amp;b&quot;&gt;&#x27;更新&#x27;&lt;/time&gt;"
+        " / 状態: &lt;script&gt;&quot;a&quot; &amp; &#x27;b&#x27;&lt;/script&gt;"
+    )
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+def test_render_rejects_missing_public_field_without_internal_fallback(
+    field: str,
+) -> None:
+    article = {
+        "updated_public_at": "2026-09-06T00:00:00Z",
+        "freshness_status": "UNKNOWN",
+        "published_at": "2026-09-05T00:00:00Z",
+    }
+    del article[field]
+    # Hostile extras must not supply missing public facts.
+    projection = {
+        "article": article,
+        "evidence": {
+            "updated_public_at": "2026-09-06T01:00:00Z",
+            "freshness_status": "FRESH",
+        },
+        "finance": {"freshness_status": "FRESH", "revenue": 999},
+    }
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice(projection)
+
+
+@pytest.mark.parametrize("field", ["updated_public_at", "freshness_status"])
+@pytest.mark.parametrize("value", [None, "", " \t\n", 0, False, [], {}])
+def test_render_rejects_unavailable_or_non_string_public_values(
+    field: str,
+    value: object,
+) -> None:
+    article: dict[str, object] = {
+        "updated_public_at": "2026-09-06T00:00:00Z",
+        "freshness_status": "UNKNOWN",
+        field: value,
+    }
+
+    with pytest.raises(ValueError, match=rf"article\.{field}"):
+        render_public_update_notice({"article": article})
+
+
+@pytest.mark.parametrize(
+    "projection",
+    [None, [], "", {}, {"article": None}, {"article": []}, {"article": ""}],
+)
+def test_render_rejects_missing_or_malformed_article(projection: object) -> None:
+    with pytest.raises(ValueError, match="projection"):
+        render_public_update_notice(cast(Mapping[str, object], projection))
+
+
+def test_recorded_projection_without_public_update_time_is_not_renderable(
+    step: RecordedPublicProjectionStep,
+) -> None:
+    projection = step.result.projection()
+    article = cast(dict[str, object], projection["article"])
+    assert article["updated_public_at"] is None
+
+    with pytest.raises(ValueError, match=r"article\.updated_public_at"):
+        render_public_update_notice(projection)
