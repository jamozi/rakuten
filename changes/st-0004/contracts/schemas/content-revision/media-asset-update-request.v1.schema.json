{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content-revision/media-asset-update-request.v1.schema.json",
  "title": "Media Asset Update Request",
  "description": "Concurrency-guarded metadata/status transition; asset bytes are immutable.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alt_text": {
      "type": "string",
      "maxLength": 2000
    },
    "decorative": {
      "type": "boolean"
    },
    "long_description_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "BLOCKED",
        "RETIRED"
      ]
    }
  },
  "required": [],
  "x-raos-invariants": {
    "asset_identity_and_hash_immutable": true
  }
}
