{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content-revision/media-asset-resource.v1.schema.json",
  "title": "Media Asset Resource",
  "description": "Source- and artifact-bound media asset.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "display_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "asset_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "raw_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "modification_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "alt_text": {
      "type": "string",
      "maxLength": 2000
    },
    "decorative": {
      "type": "boolean"
    },
    "long_description_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "captured_or_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "BLOCKED",
        "RETIRED"
      ]
    },
    "approved_by_principal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "display_id",
    "asset_class",
    "source_id",
    "raw_artifact_id",
    "asset_sha256",
    "license_status",
    "modification_policy",
    "alt_text",
    "decorative",
    "long_description_artifact_id",
    "width",
    "height",
    "captured_or_observed_at",
    "status",
    "approved_by_principal_id",
    "approved_at",
    "created_at"
  ],
  "x-raos-invariants": {
    "source_and_raw_artifact_required": true,
    "non_decorative_alt_text_required": true,
    "approved_requires_human_approval": true
  }
}
