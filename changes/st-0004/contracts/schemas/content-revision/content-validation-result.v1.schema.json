{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content-revision/content-validation-result.v1.schema.json",
  "title": "Content Validation Result",
  "description": "Deterministic schema and policy validation result.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "content_schema_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    }
  },
  "required": [
    "valid",
    "content_schema_version_id",
    "content_schema_sha256",
    "finding_codes"
  ]
}
