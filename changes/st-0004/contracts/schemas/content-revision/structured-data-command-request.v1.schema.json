{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content-revision/structured-data-command-request.v1.schema.json",
  "title": "Structured Data Command Request",
  "description": "Renderer-owned deterministic structured-data command.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seo_metadata_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "visible_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 64
    }
  },
  "required": [
    "seo_metadata_version_id",
    "visible_content_sha256",
    "generator_version"
  ],
  "x-raos-invariants": {
    "ai_json_ld_forbidden": true
  }
}
