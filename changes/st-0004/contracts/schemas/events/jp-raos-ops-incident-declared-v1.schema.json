{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/events/jp-raos-ops-incident-declared-v1.schema.json",
  "title": "jp.raos.ops.incident_declared.v1",
  "description": "Incidentが宣言された。",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "jp.raos.ops.incident_declared.v1"
        },
        "producer": {
          "const": "ops"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "incident_id": {
              "type": "string",
              "format": "uuid"
            },
            "severity": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "declared_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "incident_id",
            "severity",
            "title",
            "declared_at"
          ]
        }
      }
    }
  ]
}
