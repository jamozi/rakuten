{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/jobs/analytics-import-provider-data-v1.schema.json",
  "title": "analytics.import_provider_data.v1",
  "description": "source_typeに応じて許可済みAnalytics Adapter Jobへdispatchする。",
  "allOf": [
    {
      "$ref": "../common/job-message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "job_type": {
          "const": "analytics.import_provider_data.v1"
        },
        "queue": {
          "const": "analytics"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "site_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_type": {
              "type": "string",
              "enum": [
                "SEARCH_CONSOLE",
                "GA4",
                "KEYWORD_RANK_CSV"
              ]
            },
            "date_from": {
              "type": "string",
              "format": "date"
            },
            "date_to": {
              "type": "string",
              "format": "date"
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "force_reimport": {
              "type": "boolean"
            }
          },
          "required": [
            "site_id",
            "source_type",
            "date_from",
            "date_to"
          ]
        }
      }
    }
  ]
}
