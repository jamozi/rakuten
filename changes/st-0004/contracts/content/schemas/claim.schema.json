{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.raos.local/content/v1/claim.schema.json",
  "title": "Article Claim",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "article_version_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "direct_fact",
        "derived_fact",
        "comparative",
        "recommendation",
        "experience",
        "price_availability",
        "superlative",
        "safety_legal_regulatory",
        "predictive"
      ]
    },
    "criticality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "claim_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "evidence_link_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,199}$"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "temporal_scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "valid_until": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "as_of",
            "valid_until"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "supported",
        "conflicted",
        "unsupported",
        "removed"
      ]
    }
  },
  "required": [
    "claim_id",
    "article_version_id",
    "claim_type",
    "criticality",
    "claim_text",
    "subject_refs",
    "evidence_link_refs",
    "temporal_scope",
    "confidence",
    "status"
  ],
  "additionalProperties": false
}
