node_modules/
.npm-cache/
.node-offline-check.*/
.next/
dist/
build/
coverage/

# The repository-wide generator registry is a tracked product artifact.
!changes/build/
!changes/build/**

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json

# Temporary files
*.log
*.tmp
*.swp
*~

# Local-only browser and visual evidence; never generator or release input.
output/playwright/

# Local-only test execution evidence; tracked receipts contain only hashes.
output/pytest/
