# Local secrets and environment overrides
.env
.env.*
!.env.example
.secrets/

# Owner-only affiliate accounts and provider data (never fixtures or source).
affiliate-networks.json
/var/affiliate_ingestion/

# Python local state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
.venv-offline-check/
venv/

# Node and generated build state (toolchain is introduced by ST-0103)
node_modules/
.npm-cache/
.node-offline-check.*/
.next/
dist/
build/
coverage/
/.playwright-cli/
/output/playwright/

# The repository-wide generator registry is a tracked product artifact.
!changes/build/
!changes/build/**

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json

# Temporary files
*.log
*.tmp
*.swp
*~

# Local-only browser and visual evidence; never generator or release input.
output/playwright/
output/lighthouse/

# Local-only test execution evidence; tracked receipts contain only hashes.
output/pytest/

# Local reviewer aids and Codex environment state; never release inputs.
/.codex/environments/
/tmp/pdfs/
/tmp/reader_ledger_review.py
/tmp/update_manufacturer_sales_state.py

# Refuse accidental Chrome/Lighthouse profiles created at repository root.
/*lighthouse.*/
/nul
